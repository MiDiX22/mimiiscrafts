# Copia aquest fitxer a .env per provar el panell /admin en local (npm run dev).
# A producció, aquestes variables es configuren a Vercel: Settings → Environment Variables.

# L'usuari i la contrasenya de /admin són a src/lib/admin/credentials.ts.

# Token de GitHub amb permís "Contents: Read and write" només sobre aquest repositori.
# El panell el fa servir per desar els projectes com a commits a la branca main.
GITHUB_TOKEN=

# Opcionals (aquests són els valors per defecte)
# GITHUB_REPO=MiDiX22/mimiiscrafts
# GITHUB_BRANCH=main

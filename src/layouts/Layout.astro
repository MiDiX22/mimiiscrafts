---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
---

<!doctype html>
<html lang="ca">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Creacions fetes amb molt d'amor, fil i algun desordre. Costura, pintura i manualitats de la Mimi." />
		<meta name="theme-color" content="#9e6dff" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-512.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400..600,0..100,0..1&family=Outfit:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Mimi's Crafts</title>
	</head>
	<body class="m-0 flex min-h-dvh flex-col overflow-x-hidden bg-[var(--crema)] font-body text-zinc-900">
		<main class="flex flex-1 flex-col">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	const initHomeTransition = () => {
		const stage = document.querySelector('[data-scroll-stage]');
		const pin = document.querySelector('[data-hero-pin]');
		if (!stage || !pin) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const clamp01 = (n) => Math.min(1, Math.max(0, n));

		const updateProgress = () => {
			if (reduceMotion) return;
			const total = stage.offsetHeight - window.innerHeight;
			const scrolled = clamp01(total > 0 ? -stage.getBoundingClientRect().top / total : 0);
			pin.style.setProperty('--p', scrolled.toFixed(4));
			pin.classList.toggle('is-complete', scrolled > 0.97);
		};

		if (reduceMotion) {
			pin.style.setProperty('--p', '1');
			pin.classList.add('is-complete');
		} else {
			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateProgress();
					ticking = false;
				});
			};

			updateProgress();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll);
		}

		let anchor = 0;
		let peak = window.scrollY;
		let handoff = false;

		const contentStartsAt = () => Math.max(0, stage.offsetHeight - window.innerHeight);

		window.addEventListener(
			'scroll',
			() => {
				if (handoff) return;
				const y = window.scrollY;
				const start = contentStartsAt();

				const nowAtTop = y <= 8;
				if (nowAtTop && peak > start + 24) anchor = peak;
				if (y > peak) peak = y;
				if (nowAtTop) peak = anchor > 0 ? anchor : 0;

				if (anchor <= start + 24 || y < start) return;

				const target = anchor;
				anchor = 0;
				peak = target;
				handoff = true;
				window.scrollTo(0, target);
				handoff = false;
			},
			{ passive: true }
		);

		// Només es veu l'animació d'entrada una vegada per sessió: a les visites
		// següents saltem directament al contingut (es pot tornar a pujar per veure-la).
		const SEEN_KEY = 'mc-hero-seen';
		let seen = false;
		try {
			seen = sessionStorage.getItem(SEEN_KEY) === '1';
		} catch {}

		if (!reduceMotion && seen && !window.location.hash && window.scrollY < 8) {
			const target = contentStartsAt();
			anchor = 0;
			peak = target;
			window.scrollTo(0, target);
			updateProgress();
		}

		const markSeen = () => {
			if (window.scrollY < contentStartsAt() - 4) return;
			try {
				sessionStorage.setItem(SEEN_KEY, '1');
			} catch {}
			window.removeEventListener('scroll', markSeen);
		};
		window.addEventListener('scroll', markSeen, { passive: true });

		document.addEventListener(
			'click',
			(event) => {
				const link = event.target instanceof Element ? event.target.closest('a') : null;
				if (!link) return;
				anchor = 0;
				peak = window.scrollY;
			},
			true
		);
	};

	initHomeTransition();
</script>

---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SiteHero from '../components/SiteHero.astro';
import mimiPhoto from '../images/about/mimi.jpg';
import stickerFils from '../images/stickers/fils.png';
import stickerLlana from '../images/stickers/llana.png';
import stickerMaquina from '../images/stickers/maquinaCosir.png';
import stickerPinzells from '../images/stickers/pinzells.png';
import bookCover from '../images/about/book.jpg';
import songCover from '../images/about/song.jpg';
import movieCover from '../images/about/movie.jpg';
import tenerifePhoto from '../images/about/tenerife.jpg';
import tolousePhoto from '../images/about/tolouse.jpg';
import tromsoPhoto from '../images/about/tromso.jpg';
import nyPhoto from '../images/about/ny.jpg';
import planeHeader from '../images/about/planeHeader.png';

const featured = (await getCollection('projects'))
	.sort((a, b) => a.data.titol.localeCompare(b.data.titol, 'ca'))
	.slice(0, 3);

const picks = [
	{
		src: bookCover,
		kicker: 'Llibre',
		emoji: '📚',
		title: "La hipòtesi de l'amor",
		by: 'Ali Hazelwood',
		alt: "Coberta del llibre La hipòtesi de l'amor, d'Ali Hazelwood",
	},
	{
		src: songCover,
		kicker: 'Cançó',
		emoji: '🎧',
		title: 'Daylight',
		by: 'Taylor Swift',
		alt: 'Taylor Swift a la portada de Lover',
	},
	{
		src: movieCover,
		kicker: 'Peli',
		emoji: '🎬',
		title: 'Mamma mia',
		by: '',
		alt: 'Cartell de la pel·lícula Mamma Mia!',
	},
];

const trips = [
	{
		src: tenerifePhoto,
		place: 'Tenerife',
		flag: '🇮🇨',
		date: 'Setembre 2026',
		alt: 'Miriam al Teide, a Tenerife',
		position: 'center 70%',
	},
	{
		src: tolousePhoto,
		place: 'Toulouse',
		flag: '🇫🇷',
		date: 'Abril 2026',
		alt: 'Miriam amb maquetes de coets a Toulouse',
		position: '70% center',
	},
	{
		src: tromsoPhoto,
		place: 'Tromsø',
		flag: '🇳🇴',
		date: 'Febrer 2026',
		alt: 'Miriam sota una aurora boreal a Tromsø',
		position: 'center 38%',
	},
	{
		src: nyPhoto,
		place: 'Nova York',
		flag: '🇺🇸',
		date: 'Octubre 2024',
		alt: 'Miriam fent-se una foto entre gratacels a Nova York',
		position: '62% 42%',
	},
];
---

<Layout>
	<div class="home-flow">
	<div class="scroll-stage" data-scroll-stage>
		<SiteHero variant="scroll" active="about" />
	</div>

	<section class="featured" id="creacions" aria-labelledby="featured-title">
		<div class="featured-inner">
			<div class="featured-head">
				<h2 id="featured-title" class="section-title">Les meves creacions</h2>
				<p class="featured-lead">Una mica de tot: costura, pintura, tallers… i el que se m'acudi demà.</p>
			</div>

			<ul class="featured-grid">
				{
					featured.map((project) => (
						<li>
							<a class="featured-card" href={`/projects#${project.slug}`}>
								<span class="featured-media">
									<Image
										src={project.data.imatges[0]}
										alt=""
										class="featured-photo"
										widths={[360, 540, 720]}
										sizes="(max-width: 700px) 88vw, 22rem"
									/>
									<span class="featured-tag">{project.data.tag}</span>
								</span>
								<span class="featured-name">{project.data.titol}</span>
							</a>
						</li>
					))
				}
			</ul>

			<a class="btn" href="/projects">Veure tots els projectes <span aria-hidden="true">→</span></a>
		</div>
	</section>

	<section class="about" id="about" aria-labelledby="about-title">
		<div class="about-intro">
			<div class="about-intro-copy">
				<h2 id="about-title" class="section-title">Coneix-me</h2>
				<p>Ei, hola! Què tal? 👋</p>
				<p>Benvingut o benvinguda al meu raconet d'internet.</p>
			</div>

			<figure class="about-portrait">
				<span class="about-blob" aria-hidden="true"></span>
				<Image
					src={stickerPinzells}
					alt=""
					class="about-doodle about-doodle--pinzells"
					widths={[90, 160]}
					sizes="90px"
					loading="lazy"
				/>
				<Image
					src={stickerMaquina}
					alt=""
					class="about-doodle about-doodle--maquina"
					widths={[120, 200]}
					sizes="120px"
					loading="lazy"
				/>
				<div class="about-portrait-frame">
					<Image
						src={mimiPhoto}
						alt="Miriam asseguda a l'herba en un parc, somrient amb ulleres de sol"
						class="about-photo"
						widths={[360, 540, 720]}
						sizes="(max-width: 800px) 70vw, 320px"
						loading="lazy"
					/>
				</div>
				<figcaption class="about-caption">mimi</figcaption>
			</figure>
		</div>

		<div class="about-story">
			<div class="about-story-card">
				<p>
					Em dic Miriam i, per guanyar-me la vida, soc desenvolupadora de software (sí, soc
					d'aquelles persones que es passen hores picant codi i parlant amb les màquines). Però
					quan tanco l'ordinador de la feina... em transformo!
				</p>
				<p>
					M'apassiona fer manualitats: des de treure la màquina de cosir, fins a agafar els pinzells
					per pintar o, directament, inventar-me coses noves del no-res. Fa un temps em vaig obrir
					un perfil a Instagram per anar penjant totes aquestes "creacions" i, de cop i volta, vaig
					pensar: per què no ajunto la meva part tequi amb la meva part més creativa? I pam, així ha
					nascut aquesta web! La fusió perfecta entre la meva feina i els meus hobbies.
				</p>
			</div>
		</div>

		<div class="about-notes">
			<ul class="about-notes-list">
				<li class="about-note">
					<p>
						Fora de les pantalles i les teles, tinc tres grans debilitats: devorar novel·les
						romàntiques, escoltar la banda sonora de Mamma mia en bucle, i el pa. Soc una amant
						absoluta del pa, les coses com són! 🥖
					</p>
				</li>
				<li class="about-note">
					<p>
						A més, tinc un superpoder amagat: soc com un Shazam en persona. Posa'm un trosset diminut
						de qualsevol cançó i et diré quina és (de veritat, posa'm a prova quan vulguis, sobretot
						si és d'ABBA 😉). 🎶
					</p>
				</li>
			</ul>
		</div>

		<div class="about-close">
			<Image
				src={stickerFils}
				alt=""
				class="about-close-doodle"
				widths={[140, 220]}
				sizes="140px"
				loading="lazy"
			/>
			<div class="about-close-copy">
				<p>
					Espero de tot cor que gaudeixis xafardejant per aquí i veient el que faig tantíssim com jo
					gaudeixo creant-ho. Si tens alguna idea al cap, vols que col·laborem en alguna cosa, o
					simplement em vols recomanar un llibre o un bon forn de pa, passa't pel meu Instagram i
					parlem!
				</p>
				<p class="about-signoff">
					Una abraçada,<br />
					<span>Miriam ✨</span>
				</p>
			</div>
		</div>
	</section>

	<section class="picks" id="recomanacions" aria-labelledby="picks-title">
		<Image
			src={stickerLlana}
			alt=""
			class="picks-doodle"
			widths={[110, 180]}
			sizes="110px"
			loading="lazy"
		/>
		<div class="picks-inner">
			<h2 id="picks-title" class="section-title">Les meves recomanacions ✨</h2>
			<p class="picks-lead">
				La meva indecisió crònica fa que a vegades sigui dificilíssim triar els meus preferits,
				així que simplement he posat els que més em defineixen.
			</p>
			<ul class="picks-list">
				{
					picks.map((pick) => (
						<li class="pick">
							<article class="pick-card">
								<p class="pick-kicker">
									{pick.kicker} <span aria-hidden="true">{pick.emoji}</span>
								</p>
								<Image
									src={pick.src}
									alt={pick.alt}
									class="pick-cover"
									widths={[240, 360, 480]}
									sizes="(max-width: 900px) 46vw, 150px"
								/>
								<p class="pick-name">{pick.title}</p>
								<p class="pick-by">{pick.by}</p>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="trips" id="viatges" aria-labelledby="trips-title">
		<div class="trips-head">
			<Image
				src={planeHeader}
				alt=""
				class="trips-route"
				widths={[480, 720, 960]}
				sizes="(max-width: 700px) 88vw, 28rem"
			/>
			<h2 id="trips-title" class="section-title">Els meus últims viatges</h2>
		</div>
		<ul class="trips-list">
			{
				trips.map((trip) => (
					<li class="trip">
						<figure class="trip-frame">
							<Image
								src={trip.src}
								alt={trip.alt}
								class="trip-photo"
								style={`object-position: ${trip.position}`}
								widths={[320, 480, 720]}
								sizes="(max-width: 720px) 46vw, 240px"
							/>
						</figure>
						<p class="trip-place">
							{trip.place} <span aria-hidden="true">{trip.flag}</span>
						</p>
						<p class="trip-date">{trip.date}</p>
					</li>
				))
			}
		</ul>
	</section>
	</div>
</Layout>

<style>
	/* ---------- Comuns ---------- */
	.section-title {
		margin: 0;
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 500;
		line-height: 1.05;
		color: var(--lila);
		text-wrap: balance;
	}

	.featured-lead,
	.about-intro-copy,
	.about-story-card p,
	.about-note p,
	.about-close-copy p,
	.picks-lead {
		font-family: 'Outfit', sans-serif;
		font-size: clamp(1rem, 1.6vw, 1.1rem);
		font-weight: 500;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.5rem;
		border-radius: 999px;
		background: var(--lila-fosc);
		color: #fff;
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.btn:hover {
		color: #fff;
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: var(--ombra);
	}

	/* ---------- Escenari del hero ---------- */
	.scroll-stage {
		position: relative;
		/* Extra height offsets the next section's negative margin so scroll progress can still reach 1 */
		height: calc(120vh + 100dvh - var(--end-h));
		background: var(--crema);
	}

	/* ---------- Creacions destacades ---------- */
	.featured {
		position: relative;
		z-index: 1;
		background: var(--crema);
		color: var(--lila-fosc);
		/* Pull up so it sits flush under the collapsed header when the transition ends */
		margin-top: calc(var(--end-h) - 100dvh);
		scroll-margin-top: var(--end-h);
		padding: clamp(2.6rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4.5rem);
	}

	.featured-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 68rem;
		margin: 0 auto;
	}

	.featured-head {
		max-width: 36rem;
		text-align: center;
	}

	.featured-lead {
		margin: 0.9rem 0 0;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 20rem));
		justify-content: center;
		gap: clamp(1.1rem, 2.5vw, 1.75rem);
		width: 100%;
		margin: clamp(1.8rem, 3.5vw, 2.6rem) 0;
		padding: 0;
		list-style: none;
	}

	.featured-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.featured-card:hover {
		text-decoration: none;
	}

	.featured-media {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: var(--radi);
		background: #fff;
		box-shadow: var(--ombra);
	}

	.featured-photo {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.featured-card:hover .featured-photo,
	.featured-card:focus-visible .featured-photo {
		transform: scale(1.04);
	}

	.featured-tag {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		color: var(--lila-fosc);
		font-family: 'Outfit', sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.featured-name {
		display: block;
		margin-top: 0.9rem;
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: clamp(1.3rem, 2vw, 1.5rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--lila-fosc);
		text-align: center;
	}

	/* ---------- Coneix-me ---------- */
	.about {
		position: relative;
		z-index: 1;
		background: #fff;
		color: var(--lila-fosc);
		scroll-margin-top: var(--end-h);
		overflow: hidden;
	}

	.about-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.9fr);
		gap: clamp(1.5rem, 4vw, 3.25rem);
		align-items: center;
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(2.4rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 2rem);
	}

	.about-intro-copy p,
	.about-story-card p,
	.about-note p,
	.about-close-copy p {
		margin: 0;
	}

	.about-intro-copy .section-title {
		margin-bottom: 1rem;
	}

	.about-intro-copy p + p {
		margin-top: 0.85rem;
	}

	.about-portrait {
		position: relative;
		width: min(100%, 24rem);
		margin: 0 auto;
		padding: 2.6rem 2.1rem 0.2rem;
	}

	.about-blob,
	.about-doodle,
	.about-close-doodle,
	.picks-doodle {
		position: absolute;
		pointer-events: none;
	}

	.about-blob {
		z-index: 0;
		top: 0.35rem;
		right: 0.15rem;
		width: 8rem;
		height: 8rem;
		border-radius: 50%;
		background: var(--lila-suau);
	}

	.about-doodle,
	.about-close-doodle,
	.picks-doodle {
		z-index: 3;
		height: auto;
		max-width: none;
		filter: drop-shadow(0 8px 14px rgba(90, 70, 130, 0.14));
	}

	.about-doodle--pinzells {
		top: 0.2rem;
		left: 14%;
		width: 4.1rem;
		transform: rotate(-18deg);
	}

	.about-doodle--maquina {
		bottom: 2.4rem;
		right: -0.4rem;
		width: 5.4rem;
		transform: rotate(10deg);
	}

	.about-portrait-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		border-radius: 1.7rem;
		background: #fff;
		box-shadow: 0 16px 36px rgba(90, 70, 130, 0.16);
	}

	.about-photo {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center 18%;
	}

	.about-caption {
		position: relative;
		z-index: 1;
		margin: 0.75rem 0 0;
		text-align: center;
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: 1.45rem;
		line-height: 1.1;
		color: var(--lila);
	}

	.about-story {
		padding: 0.25rem clamp(1rem, 4vw, 2.5rem) clamp(2.75rem, 5vw, 3.75rem);
	}

	.about-story-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.15rem 2.4rem;
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(2rem, 4vw, 2.8rem) clamp(1.6rem, 4vw, 3rem);
		border-radius: 2rem;
		background: var(--crema);
	}

	/* Notes com a post-its enganxats amb cinta */
	.about-notes {
		background: var(--lila-suau);
		padding: clamp(3rem, 6vw, 4.2rem) clamp(1.25rem, 4vw, 2.5rem);
	}

	.about-notes-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.6rem, 3vw, 2.4rem);
		max-width: 60rem;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.about-note {
		position: relative;
		padding: clamp(1.6rem, 2.8vw, 2.1rem) clamp(1.35rem, 2.5vw, 1.85rem) clamp(1.35rem, 2.5vw, 1.85rem);
		border-radius: 0.4rem;
		background: #fff;
		box-shadow: var(--ombra);
		transform: rotate(-1.2deg);
	}

	.about-note:nth-child(2) {
		transform: rotate(1.4deg);
	}

	.about-note::before {
		content: '';
		position: absolute;
		top: -0.7rem;
		left: 50%;
		width: 5.5rem;
		height: 1.4rem;
		background: color-mix(in srgb, var(--cel) 75%, transparent);
		transform: translateX(-50%) rotate(-3deg);
	}

	.about-note:nth-child(2)::before {
		background: color-mix(in srgb, var(--lila) 45%, transparent);
		transform: translateX(-50%) rotate(4deg);
	}

	.about-close {
		position: relative;
		padding: clamp(2.8rem, 6vw, 4.25rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3.2rem, 6vw, 4.6rem);
	}

	.about-close-copy {
		position: relative;
		z-index: 1;
		max-width: 38rem;
		margin: 0 auto;
		text-align: center;
	}

	.about-close-copy p + p {
		margin-top: 1.35rem;
	}

	.about-signoff span {
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: 1.6rem;
		color: var(--lila);
	}

	.about-close-doodle {
		right: clamp(0.4rem, 4vw, 3.2rem);
		bottom: 12%;
		width: clamp(4.6rem, 9vw, 7rem);
		transform: rotate(10deg);
	}

	/* ---------- Recomanacions ---------- */
	.picks {
		position: relative;
		z-index: 1;
		overflow: hidden;
		background: linear-gradient(120deg, var(--cel) 0%, var(--lila-suau) 100%);
		color: var(--lila-fosc);
		padding: clamp(2.8rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem) clamp(3.6rem, 7vw, 5rem);
	}

	.picks .section-title,
	.picks .pick-name {
		color: var(--lila-fosc);
	}

	.picks-doodle {
		top: 2rem;
		left: clamp(0.4rem, 2.5vw, 1.8rem);
		width: clamp(4rem, 7vw, 5.6rem);
		transform: rotate(-12deg);
	}

	.picks-inner {
		position: relative;
		z-index: 1;
		max-width: 68rem;
		margin: 0 auto;
		text-align: center;
	}

	.picks-lead {
		max-width: 36rem;
		margin: 0.9rem auto 0;
	}

	.picks-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.9rem, 2vw, 1.3rem);
		margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.pick-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		margin: 0;
		padding: 1.35rem 1.1rem 1.4rem;
		border-radius: var(--radi);
		background: #fff;
		box-shadow: var(--ombra);
	}

	.pick-kicker {
		margin: 0;
		font-family: 'Outfit', sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.2;
	}

	.pick-cover {
		display: block;
		width: 7.2rem;
		height: 9.5rem;
		margin: 0.95rem 0 0.9rem;
		border-radius: 0.75rem;
		object-fit: cover;
		object-position: center;

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import fondo from '../images/fondo.jpg';
import logoLila from '../images/logos/logoTextLila.png';
import logoBlanc from '../images/logos/logoTextBlanc.png';
import mimiPhoto from '../images/about/mimi.jpg';
import stickerFils from '../images/stickers/fils.png';
import stickerEstisores from '../images/stickers/estisores.png';
import stickerLlana from '../images/stickers/llana.png';
import stickerMetro from '../images/stickers/metro.png';
import stickerTela from '../images/stickers/tela.png';
import stickerMaquina from '../images/stickers/maquinaCosir.png';
import stickerTote from '../images/stickers/tote.png';
import stickerPinzells from '../images/stickers/pinzells.png';
import stickerPistola from '../images/stickers/pistolaSilicona.png';
import bookCover from '../images/about/book.jpg';
import songCover from '../images/about/song.jpg';
import movieCover from '../images/about/movie.jpg';
import tenerifePhoto from '../images/about/tenerife.jpg';
import tolousePhoto from '../images/about/tolouse.jpg';
import tromsoPhoto from '../images/about/tromso.jpg';
import nyPhoto from '../images/about/ny.jpg';
import planeHeader from '../images/about/planeHeader.png';

const navLinks = [
	{ href: '/#about', label: 'Sobre mi', active: true },
	{ href: '/projects', label: 'Projectes', active: false },
	{ href: '/contact', label: 'Contacta', active: false },
];

const stickers = [
	{ src: stickerFils, className: 'sticker sticker--fils', width: 220 },
	{ src: stickerEstisores, className: 'sticker sticker--estisores', width: 170 },
	{ src: stickerLlana, className: 'sticker sticker--llana', width: 140 },
	{ src: stickerMetro, className: 'sticker sticker--metro', width: 190 },
	{ src: stickerTela, className: 'sticker sticker--tela', width: 150 },
	{ src: stickerMaquina, className: 'sticker sticker--maquina', width: 170 },
	{ src: stickerTote, className: 'sticker sticker--tote', width: 130 },
	{ src: stickerPinzells, className: 'sticker sticker--pinzells', width: 120 },
	{ src: stickerPistola, className: 'sticker sticker--pistola', width: 140 },
];

const picks = [
	{
		src: bookCover,
		kicker: 'Llibre',
		emoji: '📚',
		title: "La hipòtesi del amor",
		by: 'Ali Hazelwood',
		alt: "Coberta del llibre La hipòtesi del amor, d'Ali Hazelwood",
	},
	{
		src: songCover,
		kicker: 'Cançó',
		emoji: '🎧',
		title: 'Daylight',
		by: 'Taylor Swift',
		alt: 'Taylor Swift a la portada de Lover',
	},
	{
		src: movieCover,
		kicker: 'Peli',
		emoji: '🎬',
		title: 'Mamma mia',
		by: '',
		alt: 'Cartell de la pel·lícula Mamma Mia!',
	},
];

const trips = [
	{
		src: tenerifePhoto,
		place: 'Tenerife',
		flag: '🇮🇨',
		date: 'Setembre 2026',
		alt: 'Miriam al Teide, a Tenerife',
		position: 'center 70%',
	},
	{
		src: tolousePhoto,
		place: 'Tolouse',
		flag: '🇫🇷',
		date: 'Abril 2026',
		alt: 'Miriam amb maquetes de coets a Tolouse',
		position: '70% center',
	},
	{
		src: tromsoPhoto,
		place: 'Tromso',
		flag: '🇳🇴',
		date: 'Febrer 2026',
		alt: 'Miriam sota una aurora boreal a Tromso',
		position: 'center 38%',
	},
	{
		src: nyPhoto,
		place: 'Nova York',
		flag: '🇺🇸',
		date: 'Octubre 2024',
		alt: 'Miriam fent-se una foto entre gratacels a Nova York',
		position: '62% 42%',
	},
];
---

<Layout fullBleed>
	<div class="home-flow" style={`--fondo: url(${fondo.src})`}>
	<div class="scroll-stage" data-scroll-stage>
		<div
			class="hero-pin"
			data-hero-pin
			style="--p: 0;"
		>
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="hero-light" data-hero-light aria-hidden="true"></div>
			<canvas class="hero-glitter" data-hero-glitter aria-hidden="true"></canvas>

			<div class="hero-stickers" aria-hidden="true">
				{
					stickers.map((sticker) => (
						<Image
							src={sticker.src}
							alt=""
							class={sticker.className}
							widths={[sticker.width, sticker.width * 2]}
							sizes={`${sticker.width}px`}
							loading="eager"
						/>
					))
				}
			</div>

			<div class="header-chrome" data-header-chrome>
				<div class="header-top">
					<div class="header-side header-side--left">
						<button type="button" class="icon-btn" aria-label="Cerca">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="7"></circle>
								<path d="m20 20-3.5-3.5"></path>
							</svg>
						</button>
						<button type="button" class="icon-btn menu-toggle" aria-label="Obrir menú" aria-expanded="false" aria-controls="home-nav" data-menu-toggle>
							<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
								<path d="M4 7h16M4 12h16M4 17h16"></path>
							</svg>
						</button>
					</div>

					<div class="header-side header-side--right">
						<a href="https://www.instagram.com/mimiiscrafts?psln=MXEyYXpiMmQ2NWIxcQ==" class="social-btn" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="5"></rect>
								<circle cx="12" cy="12" r="4"></circle>
								<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
							</svg>
						</a>
						<a href="https://www.youtube.com/@mimiiscrafts" class="social-btn" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.8 5 12 5 12 5s-6.8 0-8.6.3A2.7 2.7 0 0 0 1.5 7.2 28 28 0 0 0 1.2 12a28 28 0 0 0 .3 4.8 2.7 2.7 0 0 0 1.9 1.9c1.8.3 8.6.3 8.6.3s6.8 0 8.6-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22.8 12a28 28 0 0 0-.3-4.8Z"></path>
								<path d="m10 15 5-3-5-3v6Z" fill="currentColor" stroke="none"></path>
							</svg>
						</a>
					</div>
				</div>
			</div>

			<div class="hero-logo-wrap">
				<a href="/" class="logo-home" aria-label="Mimi's Crafts — Inici">
					<span class="logo-stack" aria-hidden="true">
						<Image
							src={logoLila}
							alt=""
							class="hero-logo hero-logo--lila"
							widths={[480, 720, 960]}
							sizes="(max-width: 640px) 80vw, 34rem"
							loading="eager"
							fetchpriority="high"
						/>
						<Image
							src={logoBlanc}
							alt=""
							class="hero-logo hero-logo--blanc"
							widths={[480, 720, 960]}
							sizes="(max-width: 640px) 80vw, 34rem"
							loading="eager"
							fetchpriority="high"
						/>
					</span>
					<span class="sr-only">Mimi's Crafts</span>
				</a>
			</div>

			<p class="hero-tagline">Creacions fetes amb molt d'amor, fil i algun desordre.</p>

			<nav class="header-nav" id="home-nav" aria-label="Principal" data-home-nav>
				<ul class="nav-list">
					{
						navLinks.map((link) => (
							<li>
								<a href={link.href} class:list={['nav-link', { 'is-active': link.active }]}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>

	<div class="home-rest" data-home-rest>
	<section class="about" id="about" aria-labelledby="about-title">
		<div class="about-intro">
			<div class="about-intro-copy">
				<h2 id="about-title" class="about-title">Coneix-me</h2>
				<p>Ei, hola! Què tal? 👋</p>
				<p>Benvingut o benvinguda al meu raconet d'internet.</p>
			</div>

			<figure class="about-portrait">
				<span class="about-blob about-blob--a" aria-hidden="true"></span>
				<span class="about-blob about-blob--b" aria-hidden="true"></span>
				<span class="about-blob about-blob--c" aria-hidden="true"></span>
				<svg class="about-flower about-flower--portrait" viewBox="0 0 64 64" aria-hidden="true">
					<g fill="#d3cbfa">
						<circle cx="32" cy="12" r="11"></circle>
						<circle cx="52" cy="32" r="11"></circle>
						<circle cx="32" cy="52" r="11"></circle>
						<circle cx="12" cy="32" r="11"></circle>
					</g>
					<circle cx="32" cy="32" r="7" fill="#9e6dff"></circle>
				</svg>
				<svg class="about-heart about-heart--portrait" viewBox="0 0 32 32" aria-hidden="true">
					<path fill="#9e6dff" d="M16 27.5S6.5 21.2 6.5 14.8a5.6 5.6 0 0 1 9.5-4 5.6 5.6 0 0 1 9.5 4c0 6.4-9.5 12.7-9.5 12.7z"></path>
				</svg>
				<Image
					src={stickerPinzells}
					alt=""
					class="about-doodle about-doodle--pinzells"
					widths={[90, 160]}
					sizes="90px"
					loading="lazy"
				/>
				<Image
					src={stickerMaquina}
					alt=""
					class="about-doodle about-doodle--maquina"
					widths={[120, 200]}
					sizes="120px"
					loading="lazy"
				/>
				<Image
					src={stickerPistola}
					alt=""
					class="about-doodle about-doodle--pistola"
					widths={[110, 180]}
					sizes="110px"
					loading="lazy"
				/>
				<Image
					src={stickerTote}
					alt=""
					class="about-doodle about-doodle--tote"
					widths={[100, 160]}
					sizes="100px"
					loading="lazy"
				/>
				<div class="about-portrait-frame">
					<Image
						src={mimiPhoto}
						alt="Miriam asseguda a l'herba en un parc, somrient amb ulleres de sol"
						class="about-photo"
						widths={[360, 540, 720]}
						sizes="(max-width: 800px) 70vw, 320px"
						loading="lazy"
					/>
				</div>
				<figcaption class="about-caption">mimi</figcaption>
			</figure>
		</div>

		<div class="about-story">
			<div class="about-story-card">
				<svg class="about-flower about-flower--tr" viewBox="0 0 64 64" aria-hidden="true">
					<g fill="#fff">
						<circle cx="32" cy="12" r="11"></circle>
						<circle cx="52" cy="32" r="11"></circle>
						<circle cx="32" cy="52" r="11"></circle>
						<circle cx="12" cy="32" r="11"></circle>
					</g>
					<circle cx="32" cy="32" r="7" fill="#9e6dff"></circle>
				</svg>
				<svg class="about-flower about-flower--bl" viewBox="0 0 64 64" aria-hidden="true">
					<g fill="#b8cefd">
						<circle cx="32" cy="12" r="11"></circle>
						<circle cx="52" cy="32" r="11"></circle>
						<circle cx="32" cy="52" r="11"></circle>
						<circle cx="12" cy="32" r="11"></circle>
					</g>
					<circle cx="32" cy="32" r="7" fill="#fff"></circle>
				</svg>
				<p>
					Em dic Miriam i, per guanyar-me la vida, soc desenvolupadora de software (sí, soc
					d'aquelles persones que es passen hores picant codi i parlant amb les màquines). Però
					quan tanco l'ordinador de la feina... em transformo!
				</p>
				<p>
					M'apassiona fer manualitats: des de treure la màquina de cosir, fins a agafar els pinzells
					per pintar o, directament, inventar-me coses noves del no-res. Fa un temps em vaig obrir
					un perfil a Instagram per anar penjant totes aquestes "creacions" i, de cop i volta, vaig
					pensar: per què no ajunto la meva part tequi amb la meva part més creativa? I pam, així ha
					nascut aquesta web! La fusió perfecta entre la meva feina i els meus hobbies.
				</p>
			</div>
		</div>

		<div class="about-notes">
			<svg class="about-heart about-heart--notes" viewBox="0 0 32 32" aria-hidden="true">
				<path fill="#fff" d="M16 27.5S6.5 21.2 6.5 14.8a5.6 5.6 0 0 1 9.5-4 5.6 5.6 0 0 1 9.5 4c0 6.4-9.5 12.7-9.5 12.7z"></path>
			</svg>
			<svg class="about-star about-star--notes" viewBox="0 0 24 24" aria-hidden="true">
				<path fill="#fff" d="M12 2.2 14.4 8.7h6.8l-5.5 4 2.1 6.5L12 15.2 6.2 19.2l2.1-6.5-5.5-4h6.8L12 2.2z"></path>
			</svg>
			<ul class="about-notes-list">
				<li class="about-note">
					<p>
						Fora de les pantalles i les teles, tinc tres grans debilitats: devorar novel·les
						romàntiques, escoltar la banda sonora de Mamma mia en bucle, i el pa. Soc una amant
						absoluta del pa, les coses com són! 🥖
					</p>
				</li>
				<li class="about-note">
					<p>
						A més, tinc un superpoder amagat: soc com un Shazam en persona. Posa'm un trosset diminut
						de qualsevol cançó i et diré quina és (de veritat, posa'm a prova quan vulguis, sobretot
						si és d'ABBA 😉). 🎶
					</p>
				</li>
			</ul>
		</div>

		<div class="about-close">
			<Image
				src={stickerEstisores}
				alt=""
				class="about-close-doodle about-close-doodle--left"
				widths={[120, 200]}
				sizes="120px"
				loading="lazy"
			/>
			<Image
				src={stickerFils}
				alt=""
				class="about-close-doodle about-close-doodle--right"
				widths={[140, 220]}
				sizes="140px"
				loading="lazy"
			/>
			<div class="about-close-copy">
				<p>
					Espero de tot cor que gaudeixis xafardejant per aquí i veient el que faig tantíssim com jo
					gaudeixo creant-ho. Si tens alguna idea al cap, vols que col·laborem en alguna cosa, o
					simplement em vols recomanar un llibre o un bon forn de pa, passa't pel meu Instagram i
					parlem!
				</p>
				<p class="about-signoff">
					Una abraçada,<br />
					<span>Miriam ✨</span>
				</p>
			</div>
		</div>
	</section>

	<section class="picks" id="recomanacions" aria-labelledby="picks-title">
		<svg class="picks-flower" viewBox="0 0 64 64" aria-hidden="true">
			<g fill="#fff">
				<circle cx="32" cy="12" r="11"></circle>
				<circle cx="52" cy="32" r="11"></circle>
				<circle cx="32" cy="52" r="11"></circle>
				<circle cx="12" cy="32" r="11"></circle>
			</g>
			<circle cx="32" cy="32" r="7" fill="#9e6dff"></circle>
		</svg>
		<svg class="picks-heart" viewBox="0 0 32 32" aria-hidden="true">
			<path fill="#fff" d="M16 27.5S6.5 21.2 6.5 14.8a5.6 5.6 0 0 1 9.5-4 5.6 5.6 0 0 1 9.5 4c0 6.4-9.5 12.7-9.5 12.7z"></path>
		</svg>
		<Image
			src={stickerLlana}
			alt=""
			class="picks-doodle picks-doodle--llana"
			widths={[110, 180]}
			sizes="110px"
			loading="lazy"
		/>
		<Image
			src={stickerTela}
			alt=""
			class="picks-doodle picks-doodle--tela"
			widths={[110, 180]}
			sizes="110px"
			loading="lazy"
		/>
		<div class="picks-inner">
			<h2 id="picks-title" class="picks-title">Les meves recomanacions ✨</h2>
			<p class="picks-lead">
				La meva indecisió crònica fa que a vegades sigui dificilíssim triar els meus preferits,
				així que simplement he posat els que més em defineixen.
			</p>
			<ul class="picks-list">
				{
					picks.map((pick) => (
						<li class="pick">
							<article class="pick-card">
								<p class="pick-kicker">
									{pick.kicker} <span aria-hidden="true">{pick.emoji}</span>
								</p>
								<Image
									src={pick.src}
									alt={pick.alt}
									class="pick-cover"
									widths={[240, 360, 480]}
									sizes="(max-width: 900px) 46vw, 150px"
								/>
								<p class="pick-name">{pick.title}</p>
								<p class="pick-by">{pick.by}</p>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="trips" id="viatges" aria-labelledby="trips-title">
		<svg class="trips-star" viewBox="0 0 24 24" aria-hidden="true">
			<path fill="#9e6dff" d="M12 2.2 14.4 8.7h6.8l-5.5 4 2.1 6.5L12 15.2 6.2 19.2l2.1-6.5-5.5-4h6.8L12 2.2z"></path>
		</svg>
		<Image
			src={stickerMetro}
			alt=""
			class="trips-doodle"
			widths={[140, 220]}
			sizes="140px"
			loading="lazy"
		/>
		<div class="trips-head">
			<Image
				src={planeHeader}
				alt=""
				class="trips-route"
				widths={[480, 720, 960]}
				sizes="(max-width: 700px) 88vw, 28rem"
			/>
			<h2 id="trips-title" class="trips-title">Els meus últims viatges</h2>
		</div>
		<ul class="trips-list">
			{
				trips.map((trip) => (
					<li class="trip">
						<figure class="trip-frame">
							<Image
								src={trip.src}
								alt={trip.alt}
								class="trip-photo"
								style={`object-position: ${trip.position}`}
								widths={[320, 480, 720]}
								sizes="(max-width: 720px) 46vw, 240px"
							/>
						</figure>
						<p class="trip-place">
							{trip.place} <span aria-hidden="true">{trip.flag}</span>
						</p>
						<p class="trip-date">{trip.date}</p>
					</li>
				))
			}
		</ul>
	</section>
	</div>
	</div>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-rest.is-shifted {
		transform: translateY(var(--return-shift));
	}

	.home-flow {
		--header-h: 5.75rem;
		--nav-h: 2.35rem;
		--end-h: calc(var(--header-h) + var(--nav-h));
		--fondo: none;
		--about-bg: linear-gradient(90deg, #b8cefd 0%, #d3cbfa 100%);
		--picks-bg: #d3cbfa;
		--trips-bg: linear-gradient(90deg, #b8cefd 0%, #d3cbfa 100%);
	}

	.scroll-stage {
		position: relative;
		/* Extra height offsets the about negative margin so scroll progress can still reach 1 */
		height: calc(180vh + 100dvh - var(--end-h));
		background: var(--about-bg);
	}

	.hero-pin {
		--p: 0;
		--logo-scale: calc(1 - (0.58 * var(--p)));
		position: sticky;
		top: 0;
		z-index: 40;
		height: calc(100dvh - ((100dvh - var(--end-h)) * var(--p)));
		min-height: var(--end-h);
		overflow: hidden;
		isolation: isolate;
		background: #e6dcf5;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image: var(--fondo);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transform: scale(calc(1.16 - 0.1 * var(--p)))
			translate3d(
				calc(var(--px, 0) * -2.6% * (1 - var(--p))),
				calc(var(--py, 0) * -1.8% * (1 - var(--p))),
				0
			);
		pointer-events: none;
	}

	.hero-light {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		opacity: calc(var(--hover, 0) * clamp(0, 1 - var(--p) * 1.25, 1));
		background:
			radial-gradient(
				circle 1.35rem at var(--lx, 50%) var(--ly, 42%),
				rgba(255, 255, 255, 0.95),
				transparent 72%
			),
			radial-gradient(
				circle 16rem at var(--lx, 50%) var(--ly, 42%),
				rgba(255, 255, 255, 0.72) 0%,
				rgba(255, 236, 252, 0.28) 32%,
				rgba(214, 232, 255, 0.08) 52%,
				transparent 70%
			);
		mix-blend-mode: screen;
		transition: opacity 0.45s ease;
	}

	.hero-glitter {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: clamp(0, 1 - var(--p) * 1.35, 1);

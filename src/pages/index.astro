<script>
	const initHomeTransition = () => {
		const stage = document.querySelector('[data-scroll-stage]');
		const pin = document.querySelector('[data-hero-pin]');
		const menuToggle = document.querySelector('[data-menu-toggle]');
		const nav = document.querySelector('[data-home-nav]');
		if (!stage || !pin) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const clamp01 = (n) => Math.min(1, Math.max(0, n));

		const updateProgress = () => {
			if (reduceMotion) return;
			const total = stage.offsetHeight - window.innerHeight;
			const scrolled = clamp01(total > 0 ? -stage.getBoundingClientRect().top / total : 0);
			pin.style.setProperty('--p', scrolled.toFixed(4));
			pin.classList.toggle('is-complete', scrolled > 0.97);
		};

		if (reduceMotion) {
			pin.style.setProperty('--p', '1');
			pin.classList.add('is-complete');
		} else {
			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateProgress();
					ticking = false;
				});
			};

			updateProgress();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll);
		}

		menuToggle?.addEventListener('click', () => {
			const open = nav?.classList.toggle('is-open');
			menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			menuToggle.setAttribute('aria-label', open ? 'Tancar menú' : 'Obrir menú');
		});
	};

	initHomeTransition();
	document.addEventListener('astro:page-load', initHomeTransition);
</script>

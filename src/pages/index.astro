		filter: drop-shadow(0 8px 14px rgba(90, 70, 130, 0.12));
	}

	.trips-head {
		position: relative;
		z-index: 1;
		max-width: 40rem;
		margin: 0 auto 1.6rem;
		text-align: center;
	}

	.trips-route {
		display: block;
		width: min(100%, 28rem);
		height: auto;
		margin: 0 auto 0.15rem;
	}

	.trips-list {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
		max-width: 72rem;
		margin: 0 auto;
		padding: clamp(0.9rem, 2vw, 1.2rem);
		list-style: none;
		border-radius: 2rem;
		background: linear-gradient(120deg, #b8cefd 0%, #d3cbfa 100%);
	}

	.trip {
		display: flex;
		flex-direction: column;
		padding: 0.55rem 0.55rem 1rem;
		border-radius: 1.5rem;
		background: #fff;
		box-shadow: 0 12px 28px rgba(90, 70, 130, 0.12);
		text-align: center;
	}

	.trip-frame {
		margin: 0;
		overflow: hidden;
		border-radius: 1.05rem;
	}

	.trip-photo {
		display: block;
		width: 100%;
		aspect-ratio: 5 / 4;
		object-fit: cover;
	}

	.trip-place {
		margin: 0.8rem 0.4rem 0;
		font-family: 'Handlee', cursive;
		font-size: clamp(1.25rem, 1.8vw, 1.5rem);
		font-weight: 400;
		line-height: 1.2;
		color: #9e6dff;
	}

	.trip-date {
		margin: 0.15rem 0.4rem 0;
		font-family: 'Outfit', sans-serif;
		font-size: clamp(0.88rem, 1.2vw, 0.98rem);
		font-weight: 500;
		line-height: 1.3;
	}

	@media (max-width: 900px) {
		.about-intro,
		.about-story-card,
		.about-notes-list {
			grid-template-columns: 1fr;
		}

		.about-intro-copy {
			max-width: 40rem;
		}

		.about-portrait {
			width: min(100%, 20rem);
			padding-top: 2.2rem;
		}

		.about-doodle--maquina {
			width: 4.4rem;
		}

		.about-doodle--pistola {
			width: 4.1rem;
		}

		.about-doodle--tote,
		.about-doodle--pinzells {
			width: 3.5rem;
		}

		.about-close-doodle {
			display: none;
		}

		.picks-list {
			grid-template-columns: 1fr;
		}

		.trips-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.picks-doodle,
		.trips-doodle,
		.picks-flower,
		.picks-heart,
		.trips-star {
			display: none;
		}

		.pick-card {
			max-width: 22rem;
			margin-inline: auto;
		}
	}

	@media (max-width: 768px) {
		.home-flow {
			--header-h: 4.5rem;
			--nav-h: 0rem;
			--end-h: 4.5rem;
		}

		.sticker--pinzells,
		.sticker--pistola,
		.sticker--tote {
			display: none;
		}

		.sticker--fils {
			width: clamp(5.5rem, 28vw, 8rem);
		}

		.sticker--estisores,
		.sticker--maquina {
			width: clamp(4.5rem, 22vw, 7rem);
		}

		.sticker--llana,
		.sticker--tela {
			width: clamp(4rem, 20vw, 6.5rem);
		}

		.sticker--metro {
			width: clamp(5rem, 26vw, 8rem);
		}

		.menu-toggle {
			display: inline-flex;
		}

		.header-nav {
			display: none;
			top: var(--header-h);
			bottom: auto;
			height: auto;
			transform: none;
		}

		.header-nav.is-open {
			display: block;
		}

		.hero-pin.is-complete .header-nav {
			opacity: 1;
		}

		.nav-list {
			flex-direction: column;
			height: auto;
			padding: 0.35rem 0;
		}

		.nav-link {
			display: block;
			padding: 0.75rem 1rem;
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-stage {
			height: auto;
		}

		.hero-pin {
			--p: 1;
			position: relative;
			height: var(--end-h);
		}

		.header-chrome,
		.header-nav {
			opacity: 1;
			transform: none;
			pointer-events: auto;
		}

		.hero-tagline,
		.hero-stickers {
			display: none;
		}

		.sticker {
			animation: none;
		}
	}
</style>

<script>
	const initHomeTransition = () => {
		const stage = document.querySelector('[data-scroll-stage]');
		const pin = document.querySelector('[data-hero-pin]');
		const menuToggle = document.querySelector('[data-menu-toggle]');
		const nav = document.querySelector('[data-home-nav]');
		if (!stage || !pin) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const clamp01 = (n) => Math.min(1, Math.max(0, n));

		const updateProgress = () => {
			if (reduceMotion) return;
			const total = stage.offsetHeight - window.innerHeight;
			const scrolled = clamp01(total > 0 ? -stage.getBoundingClientRect().top / total : 0);
			pin.style.setProperty('--p', scrolled.toFixed(4));
			pin.classList.toggle('is-complete', scrolled > 0.97);
		};

		if (!reduceMotion) initHeroGlow(pin);

		if (reduceMotion) {
			pin.style.setProperty('--p', '1');
			pin.classList.add('is-complete');
		} else {
			let ticking = false;
			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					updateProgress();
					ticking = false;
				});
			};

			updateProgress();
			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll);
		}

		menuToggle?.addEventListener('click', () => {
			const open = nav?.classList.toggle('is-open');
			menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			menuToggle.setAttribute('aria-label', open ? 'Tancar menú' : 'Obrir menú');
		});

		if (document.documentElement.dataset.returnReady === 'true') return;
		document.documentElement.dataset.returnReady = 'true';

		const returnKey = 'mimi-return-path';
		const rest = document.querySelector<HTMLElement>('[data-home-rest]');
		let anchor = 0;
		let peak = window.scrollY;
		let handoff = false;

		const clearReturnPath = () => {
			try {
				sessionStorage.removeItem(returnKey);
			} catch {
				/* ignore */
			}
		};

		const contentStartsAt = () => Math.max(0, stage.offsetHeight - window.innerHeight);

		const clearShift = () => {
			rest?.classList.remove('is-shifted');
			rest?.style.removeProperty('--return-shift');
		};

		clearReturnPath();
		document.documentElement.classList.remove('is-returning');

		window.addEventListener(
			'scroll',
			() => {
				if (handoff) return;
				const y = window.scrollY;
				const start = contentStartsAt();

				const nowAtTop = y <= 8;
				if (nowAtTop && peak > start + 24) anchor = peak;
				if (y > peak) peak = y;
				if (nowAtTop) peak = anchor > 0 ? anchor : 0;

				if (!rest || anchor <= start + 24) return;

				if (y < start) {
					rest.style.setProperty('--return-shift', `${start - anchor}px`);
					rest.classList.add('is-shifted');
					return;
				}

				const target = anchor;
				anchor = 0;
				peak = target;
				clearShift();
				handoff = true;
				window.scrollTo(0, target);
				handoff = false;
			},
			{ passive: true }
		);

		document.addEventListener(
			'click',
			(event) => {
				const link = event.target instanceof Element ? event.target.closest('a') : null;
				if (!link) return;
				anchor = 0;
				peak = window.scrollY;
				clearShift();
			},
			true
		);
	};

	const initHeroGlow = (pin: HTMLElement) => {
		const canvas = pin.querySelector<HTMLCanvasElement>('[data-hero-glitter]');
		const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
		if (!canvas || !finePointer) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const colors = ['#ffffff', '#fff6dc', '#ffe7fb', '#f4ecff', '#e7f6ff'];
		const sparks: {
			x: number;
			y: number;
			size: number;
			life: number;
			decay: number;
			spin: number;
			spinSpeed: number;
			vx: number;
			vy: number;
			color: string;
			star: boolean;
		}[] = [];

		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let pointerX = 0;
		let pointerY = 0;
		let inside = false;
		let running = false;
		let frame = 0;

		const resize = () => {
			const rect = pin.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const width = Math.max(1, Math.round(rect.width * dpr));
			const height = Math.max(1, Math.round(rect.height * dpr));
			if (canvas.width !== width || canvas.height !== height) {
				canvas.width = width;
				canvas.height = height;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			}
		};

		const spawn = (x: number, y: number, count: number) => {
			for (let i = 0; i < count; i += 1) {
				const angle = Math.random() * Math.PI * 2;
				const radius = Math.random() ** 0.55 * 86;
				const star = Math.random() < 0.62;
				sparks.push({
					x: x + Math.cos(angle) * radius,
					y: y + Math.sin(angle) * radius,
					size: star ? 2.4 + Math.random() * 5.2 : 1.1 + Math.random() * 2.1,
					life: 0.55 + Math.random() * 0.45,
					decay: 0.008 + Math.random() * 0.016,
					spin: Math.random() * Math.PI,
					spinSpeed: (Math.random() - 0.5) * 0.08,
					vx: (Math.random() - 0.5) * 0.28,
					vy: -0.08 - Math.random() * 0.28,
					color: colors[Math.floor(Math.random() * colors.length)] ?? '#ffffff',
					star,
				});
			}
			if (sparks.length > 160) sparks.splice(0, sparks.length - 160);
		};

		const drawStar = (x: number, y: number, radius: number) => {
			ctx.beginPath();
			ctx.moveTo(x, y - radius);
			ctx.quadraticCurveTo(x, y, x + radius, y);
			ctx.quadraticCurveTo(x, y, x, y + radius);
			ctx.quadraticCurveTo(x, y, x - radius, y);
			ctx.quadraticCurveTo(x, y, x, y - radius);
			ctx.fill();
		};

		const tick = () => {
			currentX += (targetX - currentX) * 0.075;
			currentY += (targetY - currentY) * 0.075;
			pin.style.setProperty('--px', currentX.toFixed(3));
			pin.style.setProperty('--py', currentY.toFixed(3));

			const progress = Number.parseFloat(pin.style.getPropertyValue('--p')) || 0;
			resize();
			const rect = pin.getBoundingClientRect();
			ctx.clearRect(0, 0, rect.width, rect.height);

			if (inside && progress < 0.72) {
				frame += 1;
				if (frame % 2 === 0) spawn(pointerX, pointerY, 1);
			}

			for (let i = sparks.length - 1; i >= 0; i -= 1) {
				const spark = sparks[i];
				if (!spark) continue;
				spark.life -= spark.decay;
				if (spark.life <= 0) {
					sparks.splice(i, 1);
					continue;
				}
				spark.x += spark.vx;
				spark.y += spark.vy;
				spark.spin += spark.spinSpeed;
				const twinkle = 0.35 + 0.65 * Math.abs(Math.sin(spark.spin * 6 + spark.x));
				ctx.globalAlpha = Math.max(0, spark.life) * twinkle * (1 - progress);
				ctx.fillStyle = spark.color;
				if (spark.star) drawStar(spark.x, spark.y, spark.size);
				else {
					ctx.beginPath();
					ctx.arc(spark.x, spark.y, spark.size * 0.45, 0, Math.PI * 2);
					ctx.fill();
				}
			}
			ctx.globalAlpha = 1;

			const settled =
				!inside &&
				sparks.length === 0 &&
				Math.abs(targetX - currentX) < 0.004 &&
				Math.abs(targetY - currentY) < 0.004;

			if (settled) {
				running = false;
				pin.style.setProperty('--px', '0');
				pin.style.setProperty('--py', '0');
				return;
			}

			requestAnimationFrame(tick);
		};

		const ensureLoop = () => {
			if (running) return;
			running = true;
			requestAnimationFrame(tick);
		};

		pin.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse') return;
			const rect = pin.getBoundingClientRect();
			const x = event.clientX - rect.left;
			const y = event.clientY - rect.top;
			const progress = Number.parseFloat(pin.style.getPropertyValue('--p')) || 0;
			pointerX = x;
			pointerY = y;
			inside = progress < 0.82;
			targetX = inside ? (x / rect.width) * 2 - 1 : 0;
			targetY = inside ? (y / rect.height) * 2 - 1 : 0;
			pin.style.setProperty('--lx', `${(x / rect.width) * 100}%`);
			pin.style.setProperty('--ly', `${(y / rect.height) * 100}%`);
			pin.style.setProperty('--hover', inside ? '1' : '0');
			if (inside) spawn(x, y, 2);
			ensureLoop();
		});

		pin.addEventListener('pointerleave', () => {
			inside = false;
			targetX = 0;
			targetY = 0;
			pin.style.setProperty('--hover', '0');
			ensureLoop();
		});

		window.addEventListener('resize', resize);
	};

	initHomeTransition();
	document.addEventListener('astro:page-load', initHomeTransition);
</script>

---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import fondo from '../../images/fondo.jpg';
import logoLila from '../../images/logos/logoTextLila.png';
import logoBlanc from '../../images/logos/logoTextBlanc.png';
import stickerFils from '../../images/stickers/fils.png';
import stickerEstisores from '../../images/stickers/estisores.png';
import stickerLlana from '../../images/stickers/llana.png';
import stickerMetro from '../../images/stickers/metro.png';
import stickerTela from '../../images/stickers/tela.png';
import stickerMaquina from '../../images/stickers/maquinaCosir.png';
import stickerTote from '../../images/stickers/tote.png';
import stickerPinzells from '../../images/stickers/pinzells.png';
import stickerPistola from '../../images/stickers/pistolaSilicona.png';

const heroStickers = [
	{ src: stickerFils, className: 'pull-sticker pull-sticker--fils', width: 220 },
	{ src: stickerEstisores, className: 'pull-sticker pull-sticker--estisores', width: 170 },
	{ src: stickerLlana, className: 'pull-sticker pull-sticker--llana', width: 140 },
	{ src: stickerMetro, className: 'pull-sticker pull-sticker--metro', width: 190 },
	{ src: stickerTela, className: 'pull-sticker pull-sticker--tela', width: 150 },
	{ src: stickerMaquina, className: 'pull-sticker pull-sticker--maquina', width: 170 },
	{ src: stickerTote, className: 'pull-sticker pull-sticker--tote', width: 130 },
	{ src: stickerPinzells, className: 'pull-sticker pull-sticker--pinzells', width: 120 },
	{ src: stickerPistola, className: 'pull-sticker pull-sticker--pistola', width: 140 },
];

const navLinks = [
	{ href: '/#about', label: 'Sobre mi', active: false },
	{ href: '/projects', label: 'Projectes', active: true },
	{ href: '/#contact', label: 'Contacta', active: false },
];

const projects = (await getCollection('projects')).sort((a, b) =>
	a.data.titol.localeCompare(b.data.titol, 'ca')
);

const youtubeId = (url?: string) => {
	if (!url) return null;
	const match = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{11})/);
	return match?.[1] ?? null;
};

const tags = [...new Set(projects.map((project) => project.data.tag))].sort((a, b) =>
	a.localeCompare(b, 'ca')
);

const projectCards = await Promise.all(
	projects.map(async (project) => ({
		titol: project.data.titol,
		descripcio: project.data.descripcio,
		youtubeId: youtubeId(project.data.youtube),
		imatges: await Promise.all(
			project.data.imatges.map(async (imatge, index) => {
				const [optimized, thumb] = await Promise.all([
					getImage({ src: imatge, width: 1400 }),
					getImage({ src: imatge, width: 240 }),
				]);
				return {
					src: optimized.src,
					thumb: thumb.src,
					alt: `${project.data.titol}, foto ${index + 1}`,
				};
			})
		),
	}))
);
---

<Layout fullBleed>
	<header class="page-header" data-pull-header style={`--p: 1; --fondo: url(${fondo.src})`}>
		<div class="page-header-bg" aria-hidden="true"></div>
		<div class="pull-stickers" aria-hidden="true">
			{
				heroStickers.map((sticker) => (
					<Image
						src={sticker.src}
						alt=""
						class={sticker.className}
						widths={[sticker.width, sticker.width * 2]}
						sizes={`${sticker.width}px`}
					/>
				))
			}
		</div>
		<div class="page-header-top">
			<div class="page-header-side page-header-side--left">
				<button type="button" class="icon-btn" aria-label="Cerca">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-3.5-3.5"></path>
					</svg>
				</button>
				<button type="button" class="icon-btn menu-toggle" aria-label="Obrir menú" aria-expanded="false" aria-controls="projects-nav" data-menu-toggle>
					<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>
			<div class="page-header-side page-header-side--right">
				<a href="https://www.instagram.com/" class="social-btn" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect x="3" y="3" width="18" height="18" rx="5"></rect>
						<circle cx="12" cy="12" r="4"></circle>
						<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
					</svg>
				</a>
				<a href="https://www.youtube.com/" class="social-btn" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.8 5 12 5 12 5s-6.8 0-8.6.3A2.7 2.7 0 0 0 1.5 7.2 28 28 0 0 0 1.2 12a28 28 0 0 0 .3 4.8 2.7 2.7 0 0 0 1.9 1.9c1.8.3 8.6.3 8.6.3s6.8 0 8.6-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22.8 12a28 28 0 0 0-.3-4.8Z"></path>
						<path d="m10 15 5-3-5-3v6Z" fill="currentColor" stroke="none"></path>
					</svg>
				</a>
			</div>
		</div>
		<a href="/" class="page-logo" aria-label="Mimi's Crafts — Inici">
			<span class="page-logo-stack">
				<Image
					src={logoLila}
					alt=""
					class="page-logo-img page-logo-img--lila"
					widths={[480, 720, 960]}
					sizes="(max-width: 640px) 80vw, 34rem"
				/>
				<Image
					src={logoBlanc}
					alt=""
					class="page-logo-img page-logo-img--blanc"
					widths={[480, 720, 960]}
					sizes="(max-width: 640px) 80vw, 34rem"
				/>
			</span>
		</a>
		<p class="pull-tagline">Creacions fetes amb molt d'amor, fil i algun desordre.</p>
		<nav class="page-nav" id="projects-nav" aria-label="Principal" data-projects-nav>
			<ul class="page-nav-list">
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href} class:list={['page-nav-link', { 'is-active': link.active }]}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</header>
	<section class="projects" aria-labelledby="projects-title">
		<svg class="projects-flower" viewBox="0 0 64 64" aria-hidden="true">
			<g fill="#fff">
				<circle cx="32" cy="12" r="11"></circle>
				<circle cx="52" cy="32" r="11"></circle>
				<circle cx="32" cy="52" r="11"></circle>
				<circle cx="12" cy="32" r="11"></circle>
			</g>
			<circle cx="32" cy="32" r="7" fill="#9e6dff"></circle>
		</svg>
		<svg class="projects-heart" viewBox="0 0 32 32" aria-hidden="true">
			<path
				fill="#fff"
				d="M16 27.5S6.5 21.2 6.5 14.8a5.6 5.6 0 0 1 9.5-4 5.6 5.6 0 0 1 9.5 4c0 6.4-9.5 12.7-9.5 12.7z"
			></path>
		</svg>
		<Image
			src={stickerTela}
			alt=""
			class="projects-doodle"
			widths={[110, 180]}
			sizes="110px"
		/>

		<div class="projects-inner">
			<h1 id="projects-title" class="projects-title">Projectes</h1>

			{
				projects.length === 0 ? (
					<p class="projects-empty">Encara no hi ha cap projecte penjat.</p>
				) : (
					<>
					<div class="projects-tools">
						<label class="projects-search">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="11" cy="11" r="7"></circle>
								<path d="m20 20-3.5-3.5"></path>
							</svg>
							<input
								type="search"
								placeholder="Cerca pel títol"
								aria-label="Cerca pel títol"
								data-project-search
								autocomplete="off"
							/>
						</label>
						<label class="projects-filter">
							<select aria-label="Filtra per etiqueta" data-project-tag>
								<option value="">Totes les etiquetes</option>
								{tags.map((tag) => (
									<option value={tag}>{tag}</option>
								))}
							</select>
						</label>
					</div>
					<p class="projects-empty" data-filter-empty hidden>No hi ha cap projecte que coincideixi.</p>
					<ul class="projects-grid">
						{projects.map((project, index) => (
							<li data-project-item data-title={project.data.titol} data-tag={project.data.tag}>
								<button type="button" class="project-card" data-project-open={index}>
									<div class="project-media">
										<Image
											src={project.data.imatges[0]}
											alt=""
											class="project-photo"
											widths={[360, 540, 720]}
											sizes="(max-width: 700px) 88vw, 20rem"
										/>
										<p class="project-tag">{project.data.tag}</p>
									</div>
									<h2 class="project-title">{project.data.titol}</h2>
								</button>
							</li>
						))}
					</ul>
					</>
				)
			}
		</div>
	</section>

	<dialog class="project-dialog" data-project-dialog aria-labelledby="project-dialog-title">
		<div class="project-dialog-panel">
			<button type="button" class="project-dialog-close" data-dialog-close aria-label="Tancar">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6 6 18"></path>
				</svg>
			</button>
			<h2 id="project-dialog-title" class="project-dialog-title" data-dialog-title></h2>
			<p class="project-dialog-copy" data-dialog-copy></p>
			<div class="viewer">
				<button type="button" class="viewer-nav viewer-nav--prev" data-viewer-prev aria-label="Anterior">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m15 6-6 6 6 6"></path>
					</svg>
				</button>
				<div class="viewer-stage" data-viewer-stage></div>
				<button type="button" class="viewer-nav viewer-nav--next" data-viewer-next aria-label="Següent">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m9 6 6 6-6 6"></path>
					</svg>
				</button>
				<div class="viewer-thumbs" data-viewer-thumbs></div>
			</div>
			<p class="viewer-count" data-viewer-count></p>
		</div>
	</dialog>
	<script type="application/json" id="projects-data" set:html={JSON.stringify(projectCards)}></script>
</Layout>

<style>
	.page-header {
		--header-h: 5.75rem;
		--nav-h: 2.35rem;
		--end-h: calc(var(--header-h) + var(--nav-h));
		--p: 1;
		--logo-scale: calc(1 - (0.58 * var(--p)));
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 40;
		height: calc(100dvh - ((100dvh - var(--end-h)) * var(--p)));
		min-height: var(--end-h);
		overflow: hidden;
		background: #e6dcf5;
	}

	.page-header:has(.page-nav.is-open) {
		overflow: visible;
	}

	.page-header-bg {
		position: absolute;
		inset: 0;
		background-image: var(--fondo);
		background-size: cover;
		background-position: center;
		transform: scale(calc(1.08 - 0.08 * var(--p)));
	}

	.pull-stickers {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: clamp(0, 1 - (var(--p) * 1.55), 1);
		transform: scale(calc(1 + (0.08 * var(--p))));
		filter: blur(calc(var(--p) * 2px));
	}

	.pull-sticker {
		position: absolute;
		display: block;
		height: auto;
		max-width: none;
		user-select: none;
		filter: drop-shadow(0 6px 14px rgba(90, 70, 130, 0.14));
	}

	.pull-sticker--fils { top: 3%; left: 1.5%; width: clamp(7.5rem, 18vw, 13rem); transform: rotate(-10deg); }
	.pull-sticker--estisores { top: 4%; right: 2%; width: clamp(5.5rem, 13vw, 9.5rem); transform: rotate(18deg); }
	.pull-sticker--llana { top: 38%; left: 3%; width: clamp(4.5rem, 11vw, 8rem); transform: rotate(-6deg); }
	.pull-sticker--metro { top: 32%; right: 2.5%; width: clamp(6.5rem, 15vw, 11rem); transform: rotate(12deg); }
	.pull-sticker--tela { bottom: 16%; left: 3.5%; width: clamp(5rem, 12vw, 8.5rem); transform: rotate(-14deg); }
	.pull-sticker--maquina { bottom: 12%; right: 3%; width: clamp(5.5rem, 13vw, 9.5rem); transform: rotate(8deg); }
	.pull-sticker--tote { bottom: 3%; left: 22%; width: clamp(4rem, 10vw, 7.5rem); transform: rotate(6deg); }
	.pull-sticker--pinzells { top: 14%; left: 20%; width: clamp(3.5rem, 9vw, 6.5rem); transform: rotate(-20deg); }
	.pull-sticker--pistola { top: 15%; right: 18%; width: clamp(4rem, 10vw, 7.5rem); transform: rotate(16deg); }

	.pull-tagline {
		position: absolute;
		z-index: 2;
		left: 50%;
		top: calc(50% + clamp(3.5rem, 10vw, 5.5rem));
		width: min(28rem, 88vw);
		margin: 0;
		transform: translateX(-50%) translateY(calc(var(--p) * -1.25rem));
		text-align: center;
		font-family: 'Outfit', sans-serif;
		font-size: clamp(0.95rem, 2.4vw, 1.15rem);
		font-weight: 600;
		line-height: 1.45;
		color: #fff;
		text-shadow: 0 1px 10px rgba(120, 100, 160, 0.35);
		opacity: clamp(0, 1 - var(--p) * 1.8, 1);
		pointer-events: none;
	}

	.page-header-top {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: var(--header-h);
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1.25rem;
		opacity: clamp(0, (var(--p) - 0.35) / 0.35, 1);
	}

	.page-header-side {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.page-header-side--left {
		justify-content: flex-start;
		grid-column: 1;
	}

	.page-header-side--right {
		justify-content: flex-end;
		grid-column: 3;
	}

	.icon-btn,
	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		text-decoration: none;
		cursor: pointer;
	}

	.icon-btn {
		width: 2.25rem;
		height: 2.25rem;
	}

	.social-btn {
		width: 1.85rem;
		height: 1.85rem;
		border: 1.5px solid rgba(255, 255, 255, 0.92);
		border-radius: 0.4rem;
	}

	.icon-btn:hover,
	.social-btn:hover {
		opacity: 0.85;
		text-decoration: none;
	}

	.menu-toggle {
		display: none;
	}

	.page-logo {
		position: absolute;
		z-index: 2;
		left: 50%;
		top: calc((50% * (1 - var(--p))) + (var(--header-h) * 0.5 * var(--p)));
		width: min(34rem, 82vw);
		transform: translate(-50%, -50%) scale(var(--logo-scale));
		transform-origin: center center;
		line-height: 0;
	}

	.page-logo-stack {
		position: relative;
		display: block;
		width: 100%;
	}

	.page-logo:hover {
		text-decoration: none;
		opacity: 0.94;
	}

	.page-logo-img {
		display: block;
		width: 100%;
		height: auto;
	}

	.page-logo-img--lila {
		opacity: calc(1 - var(--p));
	}

	.page-logo-img--blanc {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: var(--p);
	}

	.page-nav {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
		height: var(--nav-h);
		background: #d3bdff;
		opacity: clamp(0, (var(--p) - 0.55) / 0.35, 1);
		transform: translateY(calc((1 - clamp(0, (var(--p) - 0.55) / 0.35, 1)) * 100%));
	}

	.page-nav-list {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.15rem 1.75rem;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.page-nav-link {
		display: inline-block;
		color: #fff;
		font-family: 'Outfit', sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
	}

	.page-nav-link:hover,
	.page-nav-link.is-active {
		color: #fff;
		text-decoration: none;
	}

	.page-nav-link.is-active {
		font-weight: 700;
	}

	.projects {
		position: relative;
		overflow: hidden;
		min-height: 100dvh;
		background: #d3cbfa;
		color: #9e6dff;
		padding: calc(5.75rem + 2.35rem + clamp(2.4rem, 5vw, 3.6rem)) clamp(1.25rem, 4vw, 2.5rem)
			clamp(3.4rem, 7vw, 5rem);
	}

	.projects-flower,
	.projects-heart,
	.projects-doodle {
		position: absolute;
		pointer-events: none;
	}

	.projects-flower {
		top: 1.1rem;
		right: clamp(0.8rem, 3vw, 2.2rem);
		width: 3.4rem;
		height: 3.4rem;
		transform: rotate(12deg);
	}

	.projects-heart {
		bottom: 1.2rem;
		left: clamp(0.8rem, 3vw, 2rem);
		width: 1.65rem;
		height: 1.65rem;
		transform: rotate(-12deg);
	}

	.projects-doodle {
		right: clamp(0.6rem, 2.5vw, 1.8rem);
		bottom: 0.8rem;
		width: 4.2rem;
		height: auto;
		transform: rotate(8deg);
		filter: drop-shadow(0 8px 14px rgba(90, 70, 130, 0.12));
	}

	.projects-inner {
		position: relative;
		z-index: 1;
		max-width: 72rem;
		margin: 0 auto;
	}

	.projects-title {
		margin: 0;
		text-align: center;
		font-family: 'Handlee', cursive;
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 400;
		line-height: 1.05;
		color: #9e6dff;
	}

	.projects-tools {
		display: flex;
		justify-content: center;
		align-items: stretch;
		gap: 0.7rem;
		max-width: 38rem;
		margin: clamp(1.15rem, 2.6vw, 1.6rem) auto 0;
	}

	.projects-search,
	.projects-filter {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.75rem;
		padding: 0 0.95rem;
		border-radius: 999px;
		background: #fff;
		box-shadow: 0 8px 18px rgba(90, 70, 130, 0.1);
		color: #9e6dff;
	}

	.projects-search {
		flex: 1 1 16rem;
	}

	.projects-filter {
		flex: 0 1 13rem;
		position: relative;
	}

	.projects-search input,
	.projects-filter select {
		width: 100%;
		min-width: 0;
		border: 0;
		background: transparent;
		color: #9e6dff;
		font-family: 'Outfit', sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		outline: none;
	}

	.projects-search input::placeholder {
		color: rgba(158, 109, 255, 0.55);
	}

	.projects-filter select {
		appearance: none;
		padding-right: 1.1rem;
		cursor: pointer;
	}

	.projects-filter::after {
		content: '';
		position: absolute;
		right: 0.95rem;
		top: 50%;
		width: 0.4rem;
		height: 0.4rem;
		border-right: 1.5px solid #9e6dff;
		border-bottom: 1.5px solid #9e6dff;
		transform: translateY(-70%) rotate(45deg);
		pointer-events: none;
	}

	.projects-search:focus-within,
	.projects-filter:focus-within {
		box-shadow: 0 0 0 2px #b8cefd, 0 8px 18px rgba(90, 70, 130, 0.1);
	}

	.projects-grid > li[hidden] {
		display: none;
	}

	.projects-empty {
		max-width: 28rem;
		margin: 1.5rem auto 0;
		text-align: center;
		font-family: 'Outfit', sans-serif;
		font-size: 1.02rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
		gap: clamp(0.9rem, 2vw, 1.3rem);
		margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		padding: 0.55rem 0.55rem 1.05rem;
		border: 0;
		border-radius: 1.5rem;
		background: #fff;
		box-shadow: 0 12px 28px rgba(90, 70, 130, 0.12);
		color: inherit;
		font: inherit;
		text-align: inherit;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 16px 32px rgba(90, 70, 130, 0.18);
	}

	.project-media {
		position: relative;
		overflow: hidden;
		border-radius: 1.05rem;
	}

	.project-photo {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center;
	}

	.project-tag {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		margin: 0;
		padding: 0.28rem 0.72rem;
		border-radius: 999px;
		background: #fff;
		color: #9e6dff;
		font-family: 'Outfit', sans-serif;
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.01em;
		box-shadow: 0 6px 14px rgba(90, 70, 130, 0.16);
	}

	.project-title {
		margin: 0.85rem 0.55rem 0;
		text-align: center;
		font-family: 'Handlee', cursive;
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: 400;
		line-height: 1.2;
		color: #9e6dff;
	}

	.project-dialog {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100dvh;
		max-width: 100vw;
		max-height: 100dvh;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: #fff;
		color: #9e6dff;
	}

	.project-dialog::backdrop {
		background: #fff;
	}

	.project-dialog-panel {
		position: relative;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		height: 100dvh;
		padding: clamp(1.1rem, 2.5vw, 1.6rem);
		background: #fff;
	}

	.project-dialog-close {
		position: absolute;
		top: 0.8rem;
		right: 0.8rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: #d3cbfa;
		color: #9e6dff;
		cursor: pointer;
	}

	.project-dialog-title {
		margin: 0 2.4rem 0.7rem 0;
		font-family: 'Handlee', cursive;
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		font-weight: 400;
		line-height: 1.15;
		color: #9e6dff;
	}

	.project-dialog-copy {
		margin: 0 0 1.1rem;
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.65;
		white-space: pre-line;
	}

	.viewer {
		position: relative;
		display: grid;
		flex: 1;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: 0.55rem 0.45rem;
		align-items: stretch;
		min-height: 0;
	}

	.viewer-stage {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		min-width: 0;
		min-height: 0;
		border-radius: 1.05rem;
		background: #d3cbfa;
	}

	.viewer-nav--prev {
		grid-column: 1;
		grid-row: 1;
	}

	.viewer-nav--next {
		grid-column: 3;
		grid-row: 1;
	}

	:global(.viewer-photo),
	:global(.viewer-video) {
		display: block;
	}

	:global(.viewer-photo) {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		background: #d3cbfa;
	}

	:global(.viewer-video) {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.viewer-nav {
		display: inline-flex;
		align-self: center;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: #d3cbfa;
		color: #9e6dff;
		cursor: pointer;
	}

	.viewer-nav[hidden] {
		display: none;
	}

	.viewer-thumbs {
		grid-column: 1 / -1;
		grid-row: 2;
		display: flex;
		justify-content: center;
		gap: 0.55rem;
		margin: 0;
		overflow-x: auto;
	}

	:global(.viewer-thumb) {
		flex: 0 0 auto;
		width: 4.6rem;
		height: 4.6rem;
		padding: 0;
		overflow: hidden;
		border: 2px solid transparent;
		border-radius: 0.7rem;
		background: #d3cbfa;
		cursor: pointer;
	}

	:global(.viewer-thumb.is-active) {
		border-color: #9e6dff;
	}

	:global(.viewer-thumb img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.viewer-count {
		margin: 0.55rem 0 0;
		text-align: center;
		font-family: 'Outfit', sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.page-header {
			--header-h: 4.5rem;
			--nav-h: 0rem;
			--end-h: 4.5rem;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.page-nav {
			display: none;
			top: var(--header-h);
			bottom: auto;
			height: auto;
			border-top: 1px solid rgba(255, 255, 255, 0.25);
		}

		.page-nav.is-open {
			display: block;
			opacity: 1;
			transform: none;
		}

		.page-nav-list {
			flex-direction: column;
			height: auto;
			padding: 0.35rem 0;
		}

		.page-nav-link {
			display: block;
			padding: 0.75rem 1rem;
			text-align: center;
		}

		.projects {
			padding-top: calc(4.5rem + clamp(1.6rem, 4vw, 2.4rem));
		}
	}

	@media (max-width: 700px) {
		.projects-tools {
			flex-direction: column;
			align-items: stretch;
		}

		.projects-search,
		.projects-filter {
			flex: 0 0 auto;
			width: 100%;
		}

		.projects-flower,
		.projects-heart,
		.projects-doodle {
			display: none;
		}

		.viewer-nav {
			position: absolute;
			top: 42%;
			z-index: 1;
		}

		.viewer-nav--prev {
			left: 0.45rem;
		}

		.viewer-nav--next {
			right: 0.45rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card {
			transition: none;
		}

		.project-card:hover {
			transform: none;
		}
	}
</style>

<script>
	type Slide =
		| { type: 'image'; src: string; thumb: string; alt: string }
		| { type: 'video'; id: string };
	type ProjectCard = {
		titol: string;
		descripcio: string;
		youtubeId: string | null;
		imatges: { src: string; thumb: string; alt: string }[];
	};

	const initProjectDialog = () => {
		const dataEl = document.getElementById('projects-data');
		const dialog = document.querySelector<HTMLDialogElement>('[data-project-dialog]');
		const title = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
		const copy = dialog?.querySelector<HTMLElement>('[data-dialog-copy]');
		const stage = dialog?.querySelector<HTMLElement>('[data-viewer-stage]');
		const thumbs = dialog?.querySelector<HTMLElement>('[data-viewer-thumbs]');
		const count = dialog?.querySelector<HTMLElement>('[data-viewer-count]');
		const prev = dialog?.querySelector<HTMLButtonElement>('[data-viewer-prev]');
		const next = dialog?.querySelector<HTMLButtonElement>('[data-viewer-next]');
		if (!dataEl || !dialog || !title || !copy || !stage || !thumbs || !count || !prev || !next) return;
		if (dialog.dataset.ready === 'true') return;
		dialog.dataset.ready = 'true';

		const projects = JSON.parse(dataEl.textContent || '[]') as ProjectCard[];
		let slides: Slide[] = [];
		let index = 0;

		const showSlide = () => {
			const slide = slides[index];
			stage.replaceChildren();
			if (!slide) return;
			if (slide.type === 'video') {
				const frame = document.createElement('iframe');
				frame.className = 'viewer-video';
				frame.src = `https://www.youtube-nocookie.com/embed/${slide.id}`;
				frame.title = title.textContent || 'Vídeo de YouTube';
				frame.allow =
					'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
				frame.allowFullscreen = true;
				stage.append(frame);
			} else {
				const image = document.createElement('img');
				image.className = 'viewer-photo';
				image.src = slide.src;
				image.alt = slide.alt;
				stage.append(image);
			}
			const total = slides.length;
			count.textContent = total > 1 ? `${index + 1} / ${total}` : '';
			prev.hidden = total < 2;
			next.hidden = total < 2;
			thumbs.querySelectorAll<HTMLButtonElement>('.viewer-thumb').forEach((thumb, thumbIndex) => {
				thumb.classList.toggle('is-active', thumbIndex === index);
				thumb.setAttribute('aria-current', thumbIndex === index ? 'true' : 'false');
			});
		};

		const renderThumbs = () => {
			thumbs.replaceChildren();
			slides.forEach((slide, slideIndex) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'viewer-thumb';
				const image = document.createElement('img');
				if (slide.type === 'video') {
					image.src = `https://i.ytimg.com/vi/${slide.id}/hqdefault.jpg`;
					image.alt = 'Vídeo de YouTube';
				} else {
					image.src = slide.thumb;
					image.alt = slide.alt;
				}
				button.append(image);
				button.addEventListener('click', () => {
					index = slideIndex;
					showSlide();
				});
				thumbs.append(button);
			});
		};

		const openProject = (projectIndex: number) => {
			const project = projects[projectIndex];
			if (!project) return;
			title.textContent = project.titol;
			copy.textContent = project.descripcio;
			slides = [
				...(project.youtubeId ? [{ type: 'video' as const, id: project.youtubeId }] : []),
				...project.imatges.map((imatge) => ({ type: 'image' as const, ...imatge })),
			];
			index = 0;
			renderThumbs();
			showSlide();
			if (!dialog.open) dialog.showModal();
		};

		document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((button) => {
			button.addEventListener('click', () => {
				openProject(Number(button.dataset.projectOpen));
			});
		});

		const step = (delta: number) => {
			if (slides.length < 2) return;
			index = (index + delta + slides.length) % slides.length;
			showSlide();
		};

		prev.addEventListener('click', () => step(-1));
		next.addEventListener('click', () => step(1));

		dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('close', () => {
			stage.replaceChildren();
			thumbs.replaceChildren();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') step(-1);
			if (event.key === 'ArrowRight') step(1);
		});
	};

	const initPageHeader = () => {
		const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const nav = document.querySelector('[data-projects-nav]');
		if (toggle && nav && toggle.dataset.ready !== 'true') {
			toggle.dataset.ready = 'true';
			toggle.addEventListener('click', () => {
				const open = nav.classList.toggle('is-open');
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Tancar menú' : 'Obrir menú');
			});
		}

		const header = document.querySelector<HTMLElement>('[data-pull-header]');
		if (!header || header.dataset.pullReady === 'true') return;
		header.dataset.pullReady = 'true';

		let progress = 1;
		const travel = () => Math.max(window.innerHeight * 1.15, 640);
		const dialogOpen = () => document.querySelector<HTMLDialogElement>('[data-project-dialog]')?.open;

		const applyPull = () => {
			header.style.setProperty('--p', progress.toFixed(4));
			document.documentElement.style.overflow = progress < 0.998 ? 'hidden' : '';
		};

		const nudge = (delta: number) => {
			const next = Math.min(1, Math.max(0, progress + delta / travel()));
			if (next === progress) return false;
			progress = next;
			applyPull();
			return true;
		};

		window.addEventListener(
			'wheel',
			(event) => {
				if (dialogOpen()) return;
				const atTop = window.scrollY <= 2;
				if (event.deltaY < 0 && atTop) {
					if (nudge(event.deltaY)) event.preventDefault();
				} else if (event.deltaY > 0 && progress < 0.998) {
					if (nudge(event.deltaY)) event.preventDefault();
				}
			},
			{ passive: false }
		);

		let lastTouch = 0;
		window.addEventListener(
			'touchstart',
			(event) => {
				lastTouch = event.touches[0]?.clientY ?? 0;
			},
			{ passive: true }
		);
		window.addEventListener(
			'touchmove',
			(event) => {
				if (dialogOpen()) return;
				const y = event.touches[0]?.clientY ?? lastTouch;
				const delta = lastTouch - y;
				lastTouch = y;
				const atTop = window.scrollY <= 2;
				if (delta < 0 && atTop) {
					if (nudge(delta)) event.preventDefault();
				} else if (delta > 0 && progress < 0.998) {
					if (nudge(delta)) event.preventDefault();
				}
			},
			{ passive: false }
		);
	};

	const fold = (value: string) =>
		value
			.normalize('NFD')
			.replace(/\p{M}/gu, '')
			.toLocaleLowerCase('ca');

	const initProjectFilters = () => {
		const search = document.querySelector<HTMLInputElement>('[data-project-search]');
		const tag = document.querySelector<HTMLSelectElement>('[data-project-tag]');
		const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
		if (!search || !tag || search.dataset.ready === 'true') return;
		search.dataset.ready = 'true';

		const apply = () => {
			const query = fold(search.value.trim());
			const selected = tag.value;
			let visible = 0;
			document.querySelectorAll<HTMLElement>('[data-project-item]').forEach((item) => {
				const title = fold(item.dataset.title ?? '');
				const itemTag = item.dataset.tag ?? '';
				const show = title.includes(query) && (selected === '' || itemTag === selected);
				item.hidden = !show;
				if (show) visible += 1;
			});
			if (empty) empty.hidden = visible !== 0;
		};

		search.addEventListener('input', apply);
		tag.addEventListener('change', apply);
	};

	initProjectDialog();
	initPageHeader();
	initProjectFilters();
	document.addEventListener('astro:page-load', () => {
		initProjectDialog();
		initPageHeader();
		initProjectFilters();
	});
</script>

---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import logoLila from '../../images/logos/logoTextLila.png';
import stickerFils from '../../images/stickers/fils.png';
import stickerEstisores from '../../images/stickers/estisores.png';
import stickerPinzells from '../../images/stickers/pinzells.png';
import { isLoggedIn } from '../../lib/admin/auth';

export const prerender = false;

if (isLoggedIn(Astro)) return Astro.redirect('/admin');

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Entrar · Mimi's Crafts" noindex>
	<section class="login">
		<Image src={stickerFils} alt="" class="login-sticker login-sticker--fils" widths={[160, 320]} sizes="8rem" />
		<Image src={stickerEstisores} alt="" class="login-sticker login-sticker--estisores" widths={[140, 280]} sizes="7rem" />
		<Image src={stickerPinzells} alt="" class="login-sticker login-sticker--pinzells" widths={[110, 220]} sizes="5.5rem" />

		<form class="login-card" data-login-form>
			<img src={logoLila.src} alt="Mimi's Crafts" class="login-logo" />
			<h1 class="login-title">Hola de nou!</h1>
			<p class="login-subtitle">Entra per gestionar els projectes.</p>

			<label class="field">
				<span>Usuari</span>
				<input name="usuari" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus />
			</label>

			<label class="field">
				<span>Contrasenya</span>
				<span class="password">
					<input name="contrasenya" type="password" autocomplete="current-password" required data-password />
					<button type="button" class="password-toggle" data-toggle-password aria-label="Mostrar la contrasenya" aria-pressed="false">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path>
							<circle cx="12" cy="12" r="3"></circle>
						</svg>
					</button>
				</span>
			</label>

			<p class="login-alert" data-login-error role="alert" hidden></p>

			<button type="submit" class="login-submit">Entrar</button>
			<a href="/" class="login-back">← Tornar a la web</a>
		</form>
	</section>
</Layout>

<style>
	.login {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 1.5rem 1rem;
		overflow: hidden;
		background: #d3cbfa;
		box-sizing: border-box;
	}

	.login-sticker {
		position: absolute;
		height: auto;
		pointer-events: none;
		filter: drop-shadow(0 10px 16px rgba(90, 70, 130, 0.16));
	}

	.login-sticker--fils {
		top: 8%;
		left: max(1rem, calc(50% - 22rem));
		width: 8rem;
		transform: rotate(-12deg);
	}

	.login-sticker--estisores {
		right: max(1rem, calc(50% - 22rem));
		bottom: 10%;
		width: 7rem;
		transform: rotate(16deg);
	}

	.login-sticker--pinzells {
		top: 12%;
		right: max(1.5rem, calc(50% - 20rem));
		width: 5.5rem;
		transform: rotate(10deg);
	}

	.login-card {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: min(100%, 23rem);
		padding: 2.2rem 1.8rem 1.6rem;
		border-radius: 1.75rem;
		background: #fff;
		box-shadow: 0 20px 44px rgba(90, 70, 130, 0.18);
		box-sizing: border-box;
	}

	.login-logo {
		width: 9.5rem;
		margin: 0 auto 0.2rem;
	}

	.login-title {
		margin: 0;
		text-align: center;
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.1;
		color: #9e6dff;
	}

	.login-subtitle {
		margin: -0.5rem 0 0.4rem;
		text-align: center;
		font-family: 'Outfit', sans-serif;
		font-weight: 500;
		color: #a796d4;
	}

	.login-alert {
		margin: 0;
		padding: 0.7rem 0.9rem;
		border-radius: 0.8rem;
		background: #ffe8ee;
		font-family: 'Outfit', sans-serif;
		font-weight: 500;
		line-height: 1.45;
		color: #b3264f;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		color: #7b5bbf;
	}

	.field input {
		width: 100%;
		box-sizing: border-box;
		padding: 0.75rem 0.95rem;
		border: 1.5px solid #ddd3fb;
		border-radius: 0.85rem;
		background: #fff;
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 1rem;
		color: #3b2d5c;
		outline: none;
	}

	.field input:focus {
		border-color: #9e6dff;
		box-shadow: 0 0 0 3px rgba(158, 109, 255, 0.18);
	}

	.password {
		position: relative;
		display: block;
	}

	.password input {
		padding-right: 3rem;
	}

	.password-toggle {
		position: absolute;
		top: 50%;
		right: 0.45rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: #a796d4;
		cursor: pointer;
		transform: translateY(-50%);
	}

	.password-toggle[aria-pressed='true'] {
		background: #ece6ff;
		color: #9e6dff;
	}

	.login-submit {
		min-height: 2.9rem;
		margin-top: 0.3rem;
		border: 0;
		border-radius: 999px;
		background: #9e6dff;
		color: #fff;
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.login-submit:hover {
		background: #8b57f5;
	}

	.login-submit:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.login-back {
		align-self: center;
		font-family: 'Outfit', sans-serif;
		font-size: 0.9rem;
		font-weight: 500;
		color: #a796d4;
	}

	@media (max-width: 560px) {
		.login-sticker--fils {
			top: 1rem;
			left: 0.5rem;
			width: 5rem;
		}

		.login-sticker--pinzells {
			display: none;
		}

		.login-sticker--estisores {
			right: 0.5rem;
			bottom: 1rem;
			width: 4.5rem;
		}
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-login-form]');
	const error = document.querySelector<HTMLElement>('[data-login-error]');
	const password = document.querySelector<HTMLInputElement>('[data-password]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-toggle-password]');

	toggle?.addEventListener('click', () => {
		if (!password) return;
		const show = password.type === 'password';
		password.type = show ? 'text' : 'password';
		toggle.setAttribute('aria-pressed', String(show));
		toggle.setAttribute('aria-label', show ? 'Amagar la contrasenya' : 'Mostrar la contrasenya');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!error) return;
		const button = form.querySelector<HTMLButtonElement>('[type=submit]')!;
		const data = new FormData(form);
		button.disabled = true;
		button.textContent = 'Entrant…';
		error.hidden = true;
		try {
			const response = await fetch('/api/admin/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ usuari: data.get('usuari'), contrasenya: data.get('contrasenya') }),
			});
			const body = await response.json().catch(() => ({}));
			if (!response.ok) throw new Error(body.error ?? 'No s’ha pogut entrar.');
			location.href = '/admin';
		} catch (err) {
			error.textContent = (err as Error).message;
			error.hidden = false;
			button.disabled = false;
			button.textContent = 'Entrar';
			password?.select();
		}
	});
</script>

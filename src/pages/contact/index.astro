---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import photo from '../../images/contact/mimiscrafs.jpeg';
import stickerFils from '../../images/stickers/fils.png';
import stickerEstisores from '../../images/stickers/estisores.png';
import stickerPinzells from '../../images/stickers/pinzells.png';
import stickerTote from '../../images/stickers/tote.png';

const socials = [
	{
		href: 'https://www.instagram.com/mimiiscrafts?psln=MXEyYXpiMmQ2NWIxcQ==',
		label: 'Instagram',
		handle: '@mimiiscrafts',
	},
	{
		href: 'https://www.youtube.com/@mimiiscrafts',
		label: 'YouTube',
		handle: '@mimiiscrafts',
	},
];
---

<Layout fullBleed>
	<Header />
	<section class="contact" id="contact" aria-labelledby="contact-title">
		<Image src={stickerFils} alt="" class="contact-deco contact-deco--fils" widths={[160, 280]} sizes="7rem" />
		<Image src={stickerEstisores} alt="" class="contact-deco contact-deco--estisores" widths={[150, 260]} sizes="6.5rem" />
		<Image src={stickerPinzells} alt="" class="contact-deco contact-deco--pinzells" widths={[120, 220]} sizes="5rem" />
		<Image src={stickerTote} alt="" class="contact-deco contact-deco--tote" widths={[130, 220]} sizes="5.5rem" />
		<svg class="contact-deco contact-deco--flower" viewBox="0 0 64 64" aria-hidden="true">
			<g fill="#fff">
				<circle cx="32" cy="12" r="11"></circle>
				<circle cx="52" cy="32" r="11"></circle>
				<circle cx="32" cy="52" r="11"></circle>
				<circle cx="12" cy="32" r="11"></circle>
			</g>
			<circle cx="32" cy="32" r="7" fill="#9e6dff"></circle>
		</svg>
		<svg class="contact-deco contact-deco--heart" viewBox="0 0 32 32" aria-hidden="true">
			<path fill="#fff" d="M16 27.5S6.5 21.2 6.5 14.8a5.6 5.6 0 0 1 9.5-4 5.6 5.6 0 0 1 9.5 4c0 6.4-9.5 12.7-9.5 12.7z"></path>
		</svg>
		<div class="contact-inner">
			<figure class="contact-portrait">
				<span class="contact-blob contact-blob--a" aria-hidden="true"></span>
				<span class="contact-blob contact-blob--b" aria-hidden="true"></span>
				<div class="contact-frame">
					<Image
						src={photo}
						alt="Miriam cosint amb la màquina de cosir"
						class="contact-photo"
						widths={[480, 720, 899]}
						sizes="(max-width: 800px) 86vw, 24rem"
					/>
				</div>
			</figure>

			<div class="contact-copy">
				<h1 id="contact-title" class="contact-title">Contacta</h1>
				<p>Vols contactar-me? Estaré encantada de respondre per xarxes!</p>
				<ul class="contact-links">
					{
						socials.map((social) => (
							<li>
								<a class="contact-link" href={social.href} target="_blank" rel="noopener noreferrer">
									<span class="contact-link-icon" aria-hidden="true">
										{social.label === 'Instagram' ? (
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
												<rect x="3" y="3" width="18" height="18" rx="5"></rect>
												<circle cx="12" cy="12" r="4"></circle>
												<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
											</svg>
										) : (
											<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
												<path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.8 5 12 5 12 5s-6.8 0-8.6.3A2.7 2.7 0 0 0 1.5 7.2 28 28 0 0 0 1.2 12a28 28 0 0 0 .3 4.8 2.7 2.7 0 0 0 1.9 1.9c1.8.3 8.6.3 8.6.3s6.8 0 8.6-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22.8 12a28 28 0 0 0-.3-4.8Z"></path>
												<path d="m10 15 5-3-5-3v6Z" fill="currentColor" stroke="none"></path>
											</svg>
										)}
									</span>
									<span class="contact-link-text">
										<span class="contact-link-label">{social.label}</span>
										<span class="contact-link-handle">{social.handle}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Layout>

<style>
	.contact {
		position: relative;
		overflow: hidden;
		min-height: calc(100dvh - 7.5rem);
		background: linear-gradient(120deg, #b8cefd 0%, #d3cbfa 100%);
		color: #9e6dff;
	}

	.contact-deco {
		position: absolute;
		z-index: 0;
		height: auto;
		pointer-events: none;
		filter: drop-shadow(0 8px 14px rgba(90, 70, 130, 0.14));
	}

	.contact-deco--fils {
		top: 6%;
		left: 1%;
		width: 6.4rem;
		transform: rotate(-14deg);
	}

	.contact-deco--estisores {
		top: 14%;
		right: 1%;
		width: 6rem;
		transform: rotate(16deg);
	}

	.contact-deco--pinzells {
		bottom: 7%;
		left: 2%;
		width: 4.6rem;
		transform: rotate(-10deg);
	}

	.contact-deco--tote {
		right: 2%;
		bottom: 6%;
		width: 5.2rem;
		transform: rotate(8deg);
	}

	.contact-deco--flower {
		top: 8%;
		right: 18%;
		width: 3.6rem;
		height: 3.6rem;
		transform: rotate(18deg);
		filter: none;
	}

	.contact-deco--heart {
		bottom: 18%;
		left: 16%;
		width: 1.8rem;
		height: 1.8rem;
		transform: rotate(-16deg);
		filter: none;
	}

	.contact-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.05fr);
		gap: clamp(1.75rem, 5vw, 4.5rem);
		align-items: center;
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 2.5rem);
	}

	.contact-portrait {
		position: relative;
		width: min(100%, 24rem);
		margin: 0 auto;
		padding: 1.6rem 1.2rem 0.4rem;
	}

	.contact-blob {
		position: absolute;
		z-index: 0;
		border-radius: 50%;
		pointer-events: none;
	}

	.contact-blob--a {
		top: 0;
		right: 0.2rem;
		width: 7.2rem;
		height: 7.2rem;
		background: #fff;
	}

	.contact-blob--b {
		bottom: 1.4rem;
		left: 0;
		width: 5.6rem;
		height: 5.6rem;
		background: #9e6dff;
		opacity: 0.28;
	}

	.contact-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		border-radius: 1.7rem;
		background: #fff;
		box-shadow: 0 16px 36px rgba(90, 70, 130, 0.16);
	}

	.contact-photo {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 68% top;
	}

	.contact-copy p {
		max-width: 34rem;
		margin: 0.9rem 0 0;
		font-family: 'Outfit', sans-serif;
		font-size: clamp(1rem, 1.7vw, 1.12rem);
		font-weight: 500;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.contact-title {
		margin: 0;
		font-family: 'Fraunces', Georgia, serif;
		font-variation-settings: 'SOFT' 100, 'WONK' 1;
		font-size: clamp(2.5rem, 5vw, 3.6rem);
		font-weight: 500;
		line-height: 1.05;
		color: #fff;
		text-shadow: 0 1px 10px rgba(110, 80, 170, 0.22);
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 1.15rem 0.55rem 0.55rem;
		background: #fff;
		color: #9e6dff;
		border-radius: 999px;
		text-decoration: none;
		box-shadow: 0 10px 22px rgba(90, 70, 130, 0.14);
		transition: transform 0.2s ease;
	}

	.contact-link:hover {
		text-decoration: none;
		transform: translateY(-2px);
	}

	.contact-link-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.55rem;
		height: 2.55rem;
		border-radius: 50%;
		background: #9e6dff;
		color: #fff;
	}

	.contact-link-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.contact-link-label {
		font-family: 'Outfit', sans-serif;
		font-size: 0.98rem;
		font-weight: 600;
	}

	.contact-link-handle {
		font-family: 'Outfit', sans-serif;
		font-size: 0.82rem;
		font-weight: 500;
		opacity: 0.8;
	}

	@media (max-width: 800px) {
		.contact-deco--fils,
		.contact-deco--estisores,
		.contact-deco--pinzells,
		.contact-deco--tote,
		.contact-deco--heart {
			display: none;
		}

		.contact-deco--flower {
			top: 0.6rem;
			right: 0.8rem;
			width: 2.6rem;
			height: 2.6rem;
		}
		.contact-inner {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.contact-copy p {
			margin-right: auto;
			margin-left: auto;
		}

		.contact-links {
			flex-direction: column;
			align-items: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-link {
			transition: none;
		}

		.contact-link:hover {
			transform: none;
		}
	}
</style>

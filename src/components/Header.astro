---
import { Image } from 'astro:assets';
import fondo from '../images/fondo.jpg';
import logo from '../images/logos/logoTextBlanc.png';

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/#about', label: 'Sobre mi' },
	{ href: '/projects', label: 'Projectes' },
	{ href: '/#contact', label: 'Contacta' },
];

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	if (href.startsWith('/#')) return false;
	return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header" style={`--fondo: url(${fondo.src})`}>
	<div class="header-top">
		<div class="header-side header-side--left">
			<button type="button" class="icon-btn" aria-label="Cerca" data-search-toggle>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="7"></circle>
					<path d="m20 20-3.5-3.5"></path>
				</svg>
			</button>
			<button type="button" class="icon-btn menu-toggle" aria-label="Obrir menú" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>

		<a href="/" class="logo-link" aria-label="Mimi's Crafts — Home">
			<Image
				src={logo}
				alt="Mimi's Crafts"
				class="logo-img"
				widths={[280, 400, 560]}
				sizes="(max-width: 640px) 200px, 280px"
				loading="eager"
			/>
		</a>

		<div class="header-side header-side--right">
			<a href="https://www.instagram.com/" class="social-btn" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="18" height="18" rx="5"></rect>
					<circle cx="12" cy="12" r="4"></circle>
					<circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
				</svg>
			</a>
			<a href="https://www.youtube.com/" class="social-btn" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M22.5 7.2a2.7 2.7 0 0 0-1.9-1.9C18.8 5 12 5 12 5s-6.8 0-8.6.3A2.7 2.7 0 0 0 1.5 7.2 28 28 0 0 0 1.2 12a28 28 0 0 0 .3 4.8 2.7 2.7 0 0 0 1.9 1.9c1.8.3 8.6.3 8.6.3s6.8 0 8.6-.3a2.7 2.7 0 0 0 1.9-1.9A28 28 0 0 0 22.8 12a28 28 0 0 0-.3-4.8Z"></path>
					<path d="m10 15 5-3-5-3v6Z" fill="currentColor" stroke="none"></path>
				</svg>
			</a>
		</div>
	</div>

	<nav class="header-nav" id="site-nav" aria-label="Principal">
		<ul class="nav-list">
			{
				navLinks.map((link) => (
					<li>
						<a href={link.href} class:list={['nav-link', { 'is-active': isActive(link.href) }]}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.header-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.5rem;
		max-width: none;
		margin: 0;
		padding: 0.65rem 1.25rem;
		background-image: var(--fondo);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	.header-side {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		min-width: 0;
	}

	.header-side--left {
		justify-content: flex-start;
	}

	.header-side--right {
		justify-content: flex-end;
	}

	.logo-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(12.5rem, 36vw, 17.5rem);
		text-decoration: none;
		line-height: 0;
	}

	.logo-link:hover {
		text-decoration: none;
		opacity: 0.92;
	}

	.logo-img {
		display: block;
		width: 100%;
		height: auto;
	}

	.icon-btn,
	.social-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		text-decoration: none;
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.icon-btn {
		width: 2.25rem;
		height: 2.25rem;
	}

	.social-btn {
		width: 1.85rem;
		height: 1.85rem;
		border: 1.5px solid rgba(255, 255, 255, 0.92);
		border-radius: 0.4rem;
	}

	.icon-btn:hover,
	.social-btn:hover {
		opacity: 0.85;
		text-decoration: none;
		transform: translateY(-1px);
	}

	.menu-toggle {
		display: none;
	}

	.header-nav {
		background: #d3bdff;
	}

	.nav-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.15rem 1.75rem;
		margin: 0;
		padding: 0.45rem 1.25rem;
		list-style: none;
	}

	.nav-link {
		display: inline-block;
		color: #fff;
		font-family: 'Outfit', sans-serif;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.nav-link:hover,
	.nav-link.is-active {
		color: #fff;
		text-decoration: none;
		opacity: 0.85;
	}

	.nav-link.is-active {
		font-weight: 700;
		opacity: 1;
	}

	@media (max-width: 768px) {
		.header-top {
			padding: 0.5rem 1rem;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.header-nav {
			display: none;
			border-top: 1px solid rgba(255, 255, 255, 0.25);
		}

		.header-nav.is-open {
			display: block;
		}

		.nav-list {
			flex-direction: column;
			gap: 0;
			padding: 0.35rem 0;
		}

		.nav-link {
			display: block;
			padding: 0.75rem 1rem;
			text-align: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.icon-btn,
		.social-btn,
		.nav-link {
			transition: none;
		}

		.icon-btn:hover,
		.social-btn:hover {
			transform: none;
		}
	}
</style>

<script>
	const menuToggle = document.querySelector('[data-menu-toggle]');
	const nav = document.querySelector('#site-nav');

	menuToggle?.addEventListener('click', () => {
		const open = nav?.classList.toggle('is-open');
		menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		menuToggle.setAttribute('aria-label', open ? 'Tancar menú' : 'Obrir menú');
	});
</script>
